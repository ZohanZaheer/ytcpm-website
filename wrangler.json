{
	"name": "ytcpm-website",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"keep_vars": true,
	"vars": {
		"ADMIN_EMAIL": "admin@ytcpm.cyou",
		"STORAGE_DRIVER": "github",
		"GITHUB_OWNER": "ZohanZaheer",
		"GITHUB_REPO": "ytcpm-website",
		"GITHUB_BRANCH": "main",
		"GITHUB_UPLOAD_DIR": "payment-screenshots",
		"MAX_UPLOAD_BYTES": "5242880"
	}
}
