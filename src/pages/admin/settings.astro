---
import BaseHead from '../../components/BaseHead.astro';
import AdminShell from '../../components/AdminShell.astro';
import { getEnv, getDatabaseUrl } from '../../lib/env';
import { adminGate } from '../../lib/adminGate';
import { adminConfigured } from '../../lib/auth';
import { getEffectiveSettings, type SiteSettings } from '../../lib/settings';

export const prerender = false;

const gate = await adminGate(Astro);
if (gate.redirect) return gate.redirect;
const email = gate.email;
const error = Astro.url.searchParams.get('error');
const configured = adminConfigured(Astro);
const saved = Astro.url.searchParams.get('saved');

let settings: SiteSettings | null = null;
let dbError = '';
if (email) {
	const dbUrl = getDatabaseUrl(Astro);
	if (!dbUrl) {
		dbError = 'The database is not configured on the server yet (DATABASE_URL).';
	} else {
		settings = await getEffectiveSettings(dbUrl, (k) => getEnv(Astro, k));
	}
}

const title = 'Payment & Download Settings (Admin)';
const description = 'Edit YTCPM payment addresses and download details.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.error {
				color: #b00020;
				font-weight: 600;
			}
			.ok {
				background: rgba(20, 108, 46, 0.1);
				border: 1px solid rgba(20, 108, 46, 0.4);
				border-radius: 8px;
				padding: 0.6em 0.9em;
				font-weight: 600;
			}
			.panel {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.1em 1.3em;
				margin-bottom: 1.2em;
			}
			.panel h2 {
				margin-top: 0;
				font-size: 1.2em;
			}
			.grid {
				display: grid;
				gap: 0.9em;
			}
			.grid label {
				display: grid;
				gap: 0.3em;
				font-weight: 600;
				font-size: 0.92em;
			}
			.grid label.check {
				display: flex;
				align-items: center;
				gap: 0.5em;
			}
			.grid label.check input {
				width: 1.1em;
				height: 1.1em;
				accent-color: var(--accent);
			}
			.grid input,
			.grid select {
				font: inherit;
				font-weight: 400;
				padding: 0.5em 0.7em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: #fff;
				color: rgb(var(--black));
			}
			.btn {
				font: inherit;
				font-weight: 700;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				border: 1px solid var(--accent);
				background: var(--accent);
				color: #fff;
				cursor: pointer;
			}
			.warn {
				background: rgba(255, 193, 7, 0.14);
				border: 1px solid rgba(255, 193, 7, 0.55);
				border-radius: 8px;
				padding: 0.6em 0.8em;
				font-size: 0.92em;
			}
			.hint {
				color: rgb(var(--gray-dark));
				font-size: 0.92em;
			}
		</style>
	</head>
	<body>
		<AdminShell title={title} active="settings" email={email} error={error} configured={configured}>
						{dbError ? (
							<p class="error">{dbError}</p>
						) : (
							settings && (
								<>
									{saved && (
										<p class="ok">
											Saved. The checkout and download pages now use these
											values.
										</p>
									)}
									<form method="post" action="/api/admin/settings">
										<div class="panel">
											<h2>Crypto payment addresses</h2>
											<p class="warn">
												⚠️ Double-check every address before saving — customers
												will send real payments to exactly what is shown here.
												Changes apply immediately.
											</p>
											<p class="hint">
												A payment method appears at checkout only when its
												switch is ON <strong>and</strong> its value is filled
												in. A switched-off or empty method is never shown.
											</p>
											<div class="grid">
												<label>
													USDT address
													<input
														type="text"
														name="usdtAddress"
														value={settings.payments.usdtAddress}
														autocomplete="off"
													/>
												</label>
												<label class="check">
													<input
														type="checkbox"
														name="usdtEnabled"
														checked={settings.payments.usdtEnabled}
													/>
													Show USDT at checkout
												</label>
												<label>
													USDT network
													<select name="usdtNetwork">
														<option
															value="TRC20"
															selected={settings.payments.usdtNetwork !== 'ERC20'}
														>
															TRC20 (Tron)
														</option>
														<option
															value="ERC20"
															selected={settings.payments.usdtNetwork === 'ERC20'}
														>
															ERC20 (Ethereum)
														</option>
													</select>
												</label>
												<label>
													BTC address
													<input
														type="text"
														name="btcAddress"
														value={settings.payments.btcAddress}
														autocomplete="off"
													/>
												</label>
												<label class="check">
													<input
														type="checkbox"
														name="btcEnabled"
														checked={settings.payments.btcEnabled}
													/>
													Show BTC at checkout
												</label>
												<label>
													ETH address
													<input
														type="text"
														name="ethAddress"
														value={settings.payments.ethAddress}
														autocomplete="off"
													/>
												</label>
												<label class="check">
													<input
														type="checkbox"
														name="ethEnabled"
														checked={settings.payments.ethEnabled}
													/>
													Show ETH at checkout
												</label>
											</div>
										</div>
										<div class="panel">
											<h2>PayPal</h2>
											<p class="hint">
												The customer sends the payment to your PayPal email,
												then submits the PayPal transaction ID and a
												screenshot here. You confirm PayPal orders manually
												in Orders — there is no automatic confirmation.
											</p>
											<div class="grid">
												<label>
													PayPal email
													<input
														type="text"
														name="paypalEmail"
														value={settings.payments.paypalEmail}
														autocomplete="off"
														placeholder="you@example.com"
													/>
												</label>
												<label class="check">
													<input
														type="checkbox"
														name="paypalEnabled"
														checked={settings.payments.paypalEnabled}
													/>
													Show PayPal at checkout
												</label>
											</div>
										</div>
										<div class="panel">
											<h2>Stripe — card payments</h2>
											<p class="hint">
												Create a Payment Link in your Stripe dashboard
												(Payment Links → New link) and paste it here — a
												link that lets the customer enter the amount works
												for every package. The customer pays on Stripe's
												own page, then submits the receipt screenshot here
												for activation. You confirm these orders in Orders.
											</p>
											<div class="grid">
												<label>
													Stripe Payment Link URL
													<input
														type="text"
														name="stripeLink"
														value={settings.payments.stripeLink}
														autocomplete="off"
														placeholder="https://buy.stripe.com/..."
													/>
												</label>
												<label class="check">
													<input
														type="checkbox"
														name="stripeEnabled"
														checked={settings.payments.stripeEnabled}
													/>
													Show card payment (Stripe) at checkout
												</label>
											</div>
										</div>
										<div class="panel">
											<h2>Download</h2>
											<div class="grid">
												<label>
													Download link (the button on the download page)
													<input
														type="text"
														name="downloadUrl"
														value={settings.download.url}
														autocomplete="off"
													/>
												</label>
												<label>
													File name shown on the site
													<input
														type="text"
														name="packageName"
														value={settings.download.packageName}
													/>
												</label>
												<label>
													File size shown on the site
													<input
														type="text"
														name="sizeLabel"
														value={settings.download.sizeLabel}
													/>
												</label>
												<label>
													Bot version shown on the site
													<input
														type="text"
														name="version"
														value={settings.download.version}
													/>
												</label>
												<label>
													SHA-256 shown for the built-in download file
													<input
														type="text"
														name="sha256"
														value={settings.download.sha256}
													/>
												</label>
											</div>
										</div>
										<div class="panel">
											<h2>Login lockout</h2>
											<p class="hint">
												Applies to customer AND admin sign-ins. After the set number of
												wrong passwords in a row, the account locks. The lock length
												grows when it happens again on the same day: 1st lockout →
												first duration, 2nd → second, 3rd and later → third.
											</p>
											<div class="grid">
												<label>
													Wrong attempts before a lock
													<input
														type="number"
														name="lockoutMaxAttempts"
														min="1"
														max="10"
														step="1"
														value={settings.lockout.maxAttempts}
													/>
												</label>
												<label>
													1st lockout (hours)
													<input
														type="number"
														name="lockoutFirstHours"
														min="1"
														max="720"
														step="1"
														value={settings.lockout.firstHours}
													/>
												</label>
												<label>
													2nd lockout, same day (hours)
													<input
														type="number"
														name="lockoutSecondHours"
														min="1"
														max="720"
														step="1"
														value={settings.lockout.secondHours}
													/>
												</label>
												<label>
													3rd lockout, same day (days)
													<input
														type="number"
														name="lockoutThirdDays"
														min="1"
														max="30"
														step="1"
														value={settings.lockout.thirdDays}
													/>
												</label>
											</div>
										</div>
										<button type="submit" class="btn">Save settings</button>
									</form>
								</>
							)
						)}
		</AdminShell>
	</body>
</html>
