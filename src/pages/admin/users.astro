---
import BaseHead from '../../components/BaseHead.astro';
import AdminShell from '../../components/AdminShell.astro';
import { getDatabaseUrl } from '../../lib/env';
import { adminGate } from '../../lib/adminGate';
import { adminConfigured } from '../../lib/auth';
import { listCustomers, FRAUD_LIMIT, type CustomerRow } from '../../lib/db';

export const prerender = false;

const gate = await adminGate(Astro);
if (gate.redirect) return gate.redirect;
const email = gate.email;
const error = Astro.url.searchParams.get('error');
const configured = adminConfigured(Astro);
const msg = Astro.url.searchParams.get('msg') ?? '';
const notices: Record<string, string> = {
	created: '✅ User created.',
};

let customers: CustomerRow[] = [];
let dbError = '';
if (email) {
	const dbUrl = getDatabaseUrl(Astro);
	if (!dbUrl) {
		dbError = 'The database is not configured on the server yet (DATABASE_URL).';
	} else {
		try {
			customers = await listCustomers(dbUrl);
		} catch {
			dbError = 'Could not read users from the database.';
		}
	}
}

// Pagination: 20 users per page, ?page=N in the URL.
const PER_PAGE = 20;
const totalPages = Math.max(1, Math.ceil(customers.length / PER_PAGE));
let page = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
if (!Number.isFinite(page) || page < 1) page = 1;
if (page > totalPages) page = totalPages;
const pageItems = customers.slice((page - 1) * PER_PAGE, page * PER_PAGE);
function pageList(cur: number, total: number): (number | '…')[] {
	if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
	const keep = [...new Set([1, 2, cur - 1, cur, cur + 1, total - 1, total])]
		.filter((n) => n >= 1 && n <= total)
		.sort((a, b) => a - b);
	const out: (number | '…')[] = [];
	keep.forEach((n, i) => {
		if (i > 0 && n - keep[i - 1] > 1) out.push('…');
		out.push(n);
	});
	return out;
}
const pages = pageList(page, totalPages);

const fmtDay = (iso: string) => new Date(iso).toLocaleDateString('en-US', { dateStyle: 'medium' });

function lockLeftText(iso: string): string {
	const ms = new Date(iso).getTime() - Date.now();
	if (!Number.isFinite(ms) || ms <= 0) return 'a short while';
	const mins = Math.ceil(ms / 60_000);
	if (mins < 60) return `${mins} min`;
	const h = Math.floor(mins / 60);
	const mm = mins % 60;
	if (h < 24) return mm ? `${h}h ${mm}m` : `${h}h`;
	const d = Math.floor(h / 24);
	const rh = h % 24;
	return rh ? `${d}d ${rh}h` : `${d}d`;
}
const title = 'Users (Admin)';
const description = 'All registered customers — view details, add users and assign licenses.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.card {
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.4em 1.6em;
				box-shadow: var(--box-shadow);
				margin-bottom: 1.4em;
			}
			.card h2 {
				margin-top: 0;
				font-size: 1.25em;
			}
			.meta {
				color: rgb(var(--gray-dark));
				font-size: 0.93em;
			}
			.tbl-wrap {
				overflow-x: auto;
			}
			table.users {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.95em;
			}
			table.users th,
			table.users td {
				text-align: left;
				padding: 0.6em 0.7em;
				border-bottom: 1px solid rgb(var(--gray-light));
				vertical-align: top;
			}
			table.users th {
				font-size: 0.82em;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				color: rgb(var(--gray-dark));
			}
			.badge {
				display: inline-block;
				font-size: 0.75em;
				font-weight: 700;
				border-radius: 999px;
				padding: 0.12em 0.7em;
				background: #dcfce7;
				color: #166534;
			}
			.badge.no {
				background: #fef3c7;
				color: #92400e;
			}
			.badge.block {
				background: #fee2e2;
				color: #991b1b;
			}
			.badge.lock {
				background: #fef3c7;
				color: #92400e;
			}
			
			
			
			.btn {
				display: inline-block;
				font: inherit;
				font-weight: 700;
				font-size: 0.92em;
				padding: 0.5em 1.2em;
				border-radius: 999px;
				border: 1px solid var(--accent);
				background: var(--accent);
				color: #fff;
				cursor: pointer;
				text-decoration: none;
			}
			.btn.ghost {
				background: transparent;
				color: var(--accent);
			}
			.pager {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35em;
				align-items: center;
				margin-top: 1.1em;
			}
			.pager a,
			.pager span {
				display: inline-block;
				padding: 0.35em 0.8em;
				border-radius: 999px;
				border: 1px solid rgb(var(--gray-light));
				font-weight: 700;
				font-size: 0.9em;
				text-decoration: none;
				color: var(--accent);
				background: var(--bg);
			}
			.pager span.on {
				background: var(--accent);
				border-color: var(--accent);
				color: #fff;
			}
			.pager span.off,
			.pager span.dots {
				color: rgb(var(--gray));
				border-color: transparent;
				background: transparent;
			}
			.notice {
				border-radius: 10px;
				padding: 0.8em 1em;
				font-weight: 600;
				background: #ffedd5;
				color: #9a3412;
				border: 1px solid #fdba74;
			}
		</style>
	</head>
	<body>
		<AdminShell title="Users" active="users" email={email} error={error} configured={configured}>
			{msg && notices[msg] && <p class="notice">{notices[msg]}</p>}
			{dbError && <p class="notice">{dbError}</p>}

			<section class="card">
				<h2>All users ({customers.length})</h2>
				{customers.length === 0 && !dbError && <p class="meta">No registered users yet.</p>}
				{customers.length > 0 && (
					<p class="meta">
						Showing {(page - 1) * PER_PAGE + 1}–{Math.min(page * PER_PAGE, customers.length)} of{' '}
						{customers.length} · Page {page} of {totalPages} ·{' '}
						<a href="/admin/users/new">Add a new user →</a>
					</p>
				)}
				{customers.length > 0 && (
					<div class="tbl-wrap">
						<table class="users">
							<thead>
								<tr>
									<th>Customer</th>
									<th>Email</th>
									<th>WhatsApp</th>
									<th>Licenses</th>
									<th>Joined</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								{pageItems.map((c) => (
									<tr>
										<td>
											<a href={`/admin/users/${c.id}`}><strong>{c.full_name ?? c.name}</strong></a>
											<br />
											<span class="meta">@{c.username ?? '—'}</span>
										</td>
										<td>
											{c.email}
											<br />
											{c.email_verified ? (
												<span class="badge">Verified</span>
											) : (
												<span class="badge no">Not verified</span>
											)}
											{c.blocked_at && (
												<>
													<br />
													<span class="badge block">🚫 Blocked — fraud</span>
												</>
											)}
											{!c.blocked_at && c.fraud_count > 0 && (
												<>
													<br />
													<span class="meta">⚠️ Fraud strikes: {c.fraud_count}/{FRAUD_LIMIT}</span>
												</>
											)}
											{c.locked_until && new Date(c.locked_until) > new Date() && (
												<>
													<br />
													<span class="badge lock">🔒 Login locked · {lockLeftText(c.locked_until)} left</span>
												</>
											)}
										</td>
										<td>{c.whatsapp ?? '—'}</td>
										<td>
											<strong>{c.licenses_total}</strong> license{c.licenses_total === 1 ? '' : 's'}
											<br />
											<span class="meta">{c.orders_total} order{c.orders_total === 1 ? '' : 's'} total</span>
										</td>
										<td>{fmtDay(c.created_at)}</td>
										<td><a class="btn ghost" href={`/admin/users/${c.id}`}>View →</a></td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				)}
				{totalPages > 1 && (
					<nav class="pager" aria-label="Users pages">
						{page > 1 ? (
							<a href={`/admin/users?page=${page - 1}`}>← Prev</a>
						) : (
							<span class="off">← Prev</span>
						)}
						{pages.map((n) =>
							n === '…' ? (
								<span class="dots">…</span>
							) : n === page ? (
								<span class="on">{n}</span>
							) : (
								<a href={`/admin/users?page=${n}`}>{n}</a>
							),
						)}
						{page < totalPages ? (
							<a href={`/admin/users?page=${page + 1}`}>Next →</a>
						) : (
							<span class="off">Next →</span>
						)}
					</nav>
				)}
			</section>


		</AdminShell>
	</body>
</html>
