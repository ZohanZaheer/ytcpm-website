---
import BaseHead from '../../components/BaseHead.astro';
import AdminShell from '../../components/AdminShell.astro';
import { getDatabaseUrl } from '../../lib/env';
import { adminGate } from '../../lib/adminGate';
import { adminConfigured } from '../../lib/auth';
import {
	listSupportRequests,
	getAuthUserById,
	getProfile,
	getOrder,
	type SupportRequest,
} from '../../lib/db';
import { supportTopicLabel } from '../../lib/support';

export const prerender = false;

const gate = await adminGate(Astro);
if (gate.redirect) return gate.redirect;
const email = gate.email;
const error = Astro.url.searchParams.get('error');
const configured = adminConfigured(Astro);

interface Row {
	req: SupportRequest;
	customer: string;
	contact: string;
	license: string;
}
let rows: Row[] = [];
let newCount = 0;
let dbError = '';
if (email) {
	const dbUrl = getDatabaseUrl(Astro);
	if (!dbUrl) {
		dbError = 'The database is not configured on the server yet (DATABASE_URL).';
	} else {
		try {
			const reqs = await listSupportRequests(dbUrl, 100);
			newCount = reqs.filter((r) => r.status === 'new').length;
			rows = await Promise.all(
				reqs.map(async (req) => {
					const [u, p, o] = await Promise.all([
						getAuthUserById(dbUrl, req.user_id).catch(() => null),
						getProfile(dbUrl, req.user_id).catch(() => null),
						req.order_id ? getOrder(dbUrl, req.order_id).catch(() => null) : Promise.resolve(null),
					]);
					return {
						req,
						customer: p?.full_name ?? u?.name ?? 'Customer',
						contact: [
							u?.email ?? '',
							p?.whatsapp ?? '',
							p?.telegram ? '@' + p.telegram : '',
							p?.username ? 'username: ' + p.username : '',
						]
							.filter(Boolean)
							.join(' · '),
						license: o ? `${o.package_label} (order ${o.id})` : '—',
					};
				}),
			);
		} catch {
			dbError = 'Could not read support requests from the database.';
		}
	}
}

const fmt = (iso: string) =>
	new Date(iso).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });

const title = 'Support Requests (Admin)';
const description = 'Priority support requests from customers with an active license.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.card {
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.3em 1.6em;
				box-shadow: var(--box-shadow);
				margin-bottom: 1.2em;
			}
			.card.fresh {
				border-color: var(--accent);
				border-width: 2px;
			}
			.card h2 {
				margin: 0 0 0.3em;
				font-size: 1.15em;
			}
			.meta {
				color: rgb(var(--gray-dark));
				font-size: 0.92em;
				margin: 0.2em 0;
			}
			.msg {
				white-space: pre-wrap;
				margin: 0.8em 0;
			}
			.badge {
				display: inline-block;
				font-size: 0.78em;
				font-weight: 700;
				border-radius: 999px;
				padding: 0.15em 0.8em;
			}
			.badge.new {
				background: #fee2e2;
				color: #991b1b;
			}
			.badge.done {
				background: #dcfce7;
				color: #166534;
			}
			.btn {
				font: inherit;
				font-weight: 700;
				font-size: 0.92em;
				background: var(--accent);
				color: #fff;
				border: 1px solid var(--accent);
				border-radius: 999px;
				padding: 0.5em 1.2em;
				cursor: pointer;
			}
			.btn.ghost {
				background: var(--surface);
				color: var(--accent-dark);
			}
			.errorbox {
				border-radius: 10px;
				padding: 0.8em 1em;
				font-weight: 600;
				background: #fee2e2;
				color: #991b1b;
				border: 1px solid #fca5a5;
			}
		</style>
	</head>
	<body>
		<AdminShell title={title} active="requests" email={email} error={error} configured={configured}>
					<h1>⚡ Support Requests {newCount > 0 && <>({newCount} new)</>}</h1>
					<p>
						Priority requests from customers with an active license, sent from inside their
						dashboard. Please handle these as soon as possible, then mark them done.
					</p>
					{dbError && <p class="errorbox">{dbError}</p>}
					{email && !dbError && rows.length === 0 && <p>No support requests yet.</p>}
					{rows.map(({ req, customer, contact, license }) => (
						<section class={`card ${req.status === 'new' ? 'fresh' : ''}`}>
							<h2>
								{supportTopicLabel(req.topic)}{' '}
								<span class={`badge ${req.status}`}>{req.status === 'new' ? 'NEW' : 'Done'}</span>
							</h2>
							<p class="meta">
								<strong>{customer}</strong> · {contact}
							</p>
							<p class="meta">License: {license} · Received {fmt(req.created_at)}</p>
							<p class="msg">{req.message}</p>
							<form method="post" action="/api/admin/requests">
								<input type="hidden" name="id" value={req.id} />
								{req.status === 'new' ? (
									<button class="btn" type="submit" name="action" value="done">Mark done</button>
								) : (
									<button class="btn ghost" type="submit" name="action" value="new">Re-open</button>
								)}
							</form>
						</section>
					))}
		</AdminShell>
	</body>
</html>
