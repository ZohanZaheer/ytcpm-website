---
import BaseHead from '../../components/BaseHead.astro';
import AdminShell from '../../components/AdminShell.astro';
import { getDatabaseUrl } from '../../lib/env';
import { adminGate } from '../../lib/adminGate';
import { adminConfigured } from '../../lib/auth';
import {
	listOrders,
	listFraudInfo,
	FRAUD_LIMIT,
	type FraudInfo,
	type PaymentOrder,
} from '../../lib/db';

export const prerender = false;

const gate = await adminGate(Astro);
if (gate.redirect) return gate.redirect;
const email = gate.email;
const error = Astro.url.searchParams.get('error');
const configured = adminConfigured(Astro);

let orders: PaymentOrder[] = [];
let fraudById = new Map<string, FraudInfo>();
let fraudByEmail = new Map<string, FraudInfo>();
let dbError = '';
if (email) {
	const dbUrl = getDatabaseUrl(Astro);
	if (!dbUrl) {
		dbError = 'The order database is not configured on the server yet (DATABASE_URL).';
	} else {
		try {
			orders = await listOrders(dbUrl, 100);
			const infos = await listFraudInfo(dbUrl).catch(() => [] as FraudInfo[]);
			fraudById = new Map(infos.map((f) => [f.id, f]));
			fraudByEmail = new Map(infos.map((f) => [f.email.toLowerCase(), f]));
		} catch {
			dbError = 'Could not read orders from the database.';
		}
	}
}
const fraudFor = (o: PaymentOrder): FraudInfo | null =>
	(o.user_id ? fraudById.get(o.user_id) : undefined) ??
	fraudByEmail.get(o.email.toLowerCase()) ??
	null;

const msg = Astro.url.searchParams.get('msg') ?? '';
const notices: Record<string, string> = {
	fraud: '🚫 Fraud strike recorded for this customer.',
	'fraud-blocked': `🚫 Third fraud strike — this customer is now BLOCKED and signed out everywhere.`,
	'fraud-already': 'This order was already marked as fraud.',
	'fraud-error': '⚠️ Could not record the fraud mark — please try again.',
};

const title = 'Payment Orders (Admin)';
const description = 'Review and confirm YTCPM license payment orders.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.error {
				color: #b00020;
				font-weight: 600;
			}
			.table-wrap {
				overflow-x: auto;
			}
			table.orders {
				border-collapse: collapse;
				width: 100%;
				font-size: 0.85em;
			}
			table.orders th,
			table.orders td {
				border: 1px solid rgb(var(--gray-light));
				padding: 0.45em 0.55em;
				text-align: left;
				vertical-align: top;
			}
			.status {
				font-weight: 700;
				text-transform: capitalize;
			}
			.st-pending {
				color: #9a6b00;
			}
			.st-confirmed {
				color: #146c2e;
			}
			.st-rejected {
				color: #b00020;
			}
			.actions {
				display: flex;
				gap: 0.4em;
				flex-wrap: wrap;
			}
			.btn {
				font: inherit;
				font-size: 0.92em;
				font-weight: 700;
				padding: 0.3em 0.7em;
				border-radius: 8px;
				border: 1px solid var(--accent);
				background: var(--accent);
				color: #fff;
				cursor: pointer;
			}
			.btn.ghost {
				background: #fff;
				color: var(--accent);
			}
			.btn.danger {
				border-color: #b00020;
				background: #b00020;
			}
			.btn.fraud {
				border-color: #7c2d12;
				background: #7c2d12;
			}
			.notice {
				border-radius: 10px;
				padding: 0.8em 1em;
				font-weight: 600;
				background: #ffedd5;
				color: #9a3412;
				border: 1px solid #fdba74;
			}
			.fraud-info {
				color: #b45309;
				font-weight: 700;
			}
			.blocked-badge {
				display: inline-block;
				margin-top: 0.3em;
				padding: 0.15em 0.6em;
				border-radius: 999px;
				background: #b00020;
				color: #fff;
				font-weight: 700;
				font-size: 0.85em;
			}
			.fraud-done {
				display: inline-block;
				padding: 0.3em 0.7em;
				border-radius: 8px;
				background: #fef3c7;
				color: #92400e;
				font-weight: 700;
				font-size: 0.92em;
			}
			.proof-btn {
				padding: 0;
				border: none;
				background: none;
				cursor: pointer;
				line-height: 0;
			}
			.proof-thumb {
				width: 64px;
				height: 64px;
				object-fit: cover;
				border-radius: 8px;
				border: 1px solid rgb(var(--gray-light));
			}
			.proof-btn:hover .proof-thumb {
				border-color: var(--accent);
			}
			.modal {
				position: fixed;
				inset: 0;
				z-index: 90;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.modal[hidden] {
				display: none;
			}
			.modal-backdrop {
				position: absolute;
				inset: 0;
				background: rgba(20, 10, 4, 0.78);
			}
			.modal-box {
				position: relative;
				max-width: 92vw;
				max-height: 90vh;
			}
			.modal-box img {
				display: block;
				max-width: 92vw;
				max-height: 90vh;
				border-radius: 10px;
				background: #fff;
			}
			.modal-close {
				position: absolute;
				top: -14px;
				right: -14px;
				width: 38px;
				height: 38px;
				border-radius: 999px;
				border: none;
				background: var(--accent);
				color: #fff;
				font-size: 1.05em;
				font-weight: 800;
				cursor: pointer;
				box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
			}
			.mono {
				font-family: ui-monospace, monospace;
				font-size: 0.92em;
				overflow-wrap: anywhere;
			}
		</style>
	</head>
	<body>
		<AdminShell title={title} active="orders" email={email} error={error} configured={configured}>
						{msg && notices[msg] && <p class="notice">{notices[msg]}</p>}
						{dbError ? (
							<p class="error">{dbError}</p>
						) : orders.length === 0 ? (
							<p>
								No orders yet. New customer orders will appear here as soon as
								someone submits a payment.
							</p>
						) : (
							<div class="table-wrap">
								<table class="orders">
									<thead>
										<tr>
											<th>Order</th>
											<th>Customer</th>
											<th>Package</th>
											<th>Payment</th>
											<th>Proof</th>
											<th>Status</th>
											<th>Actions</th>
										</tr>
									</thead>
									<tbody>
										{orders.map((o) => (
											<tr>
												<td>
													<span class="mono">{o.id}</span>
													<br />
													{new Date(o.created_at).toLocaleString()}
												</td>
												<td>
													{o.customer_name}
													<br />
													{o.email}
													{o.contact && (
														<>
															<br />
															{o.contact}
														</>
													)}
													{o.note && (
														<>
															<br />
															<em>{o.note}</em>
														</>
													)}
												{(() => { const f = fraudFor(o); return f && f.fraud_count > 0 ? (
													<>
														<br />
														<span class="fraud-info">⚠️ Fraud strikes: {f.fraud_count}/{FRAUD_LIMIT}</span>
													</>
												) : null; })()}
												{(() => { const f = fraudFor(o); return f && f.blocked_at ? (
													<>
														<br />
														<span class="blocked-badge">🚫 Blocked — fraud</span>
													</>
												) : null; })()}
												</td>
												<td>
													{o.package_label}
													<br />${o.amount_usd}
												</td>
												<td>
													{o.crypto}
													{o.network ? ` (${o.network})` : ''}
													{o.tx_hash && (
														<>
															<br />
															<span class="mono">{o.tx_hash}</span>
														</>
													)}
												</td>
												<td>
													{o.screenshot_ref ? (
													<button type="button" class="proof-btn" data-proof={`/api/screenshot/${o.id}`} title="View payment screenshot">
														<img class="proof-thumb" src={`/api/screenshot/${o.id}`} alt="Payment screenshot" loading="lazy" />
													</button>
												) : (
													<span class="mono">—</span>
												)}
												</td>
												<td class={`status st-${o.status}`}>{o.status}</td>
												<td>
													<div class="actions">
														<form method="post" action="/api/admin/update">
															<input type="hidden" name="id" value={o.id} />
															<input
																type="hidden"
																name="status"
																value="confirmed"
															/>
															<button class="btn" type="submit">
																Confirm
															</button>
														</form>
														<form method="post" action="/api/admin/update">
															<input type="hidden" name="id" value={o.id} />
															<input
																type="hidden"
																name="status"
																value="rejected"
															/>
															<button class="btn danger" type="submit">
																Reject
															</button>
														</form>
														<form method="post" action="/api/admin/update">
															<input type="hidden" name="id" value={o.id} />
															<input
																type="hidden"
																name="status"
																value="pending"
															/>
															<button class="btn ghost" type="submit">
																Reset
															</button>
														</form>
													{o.fraud_at ? (
														<span class="fraud-done">🚫 Marked fraud</span>
													) : (
														<form method="post" action="/api/admin/fraud" onsubmit="return confirm('Mark this order as fraud? This adds a strike to the customer — at 3 strikes the account is blocked.')">
															<input type="hidden" name="id" value={o.id} />
															<button class="btn fraud" type="submit">Fraud</button>
														</form>
													)}
													</div>
												</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						)}
			<div class="modal" id="proof-modal" hidden>
				<div class="modal-backdrop" data-close></div>
				<div class="modal-box">
					<img id="proof-img" src="" alt="Payment screenshot" />
					<button type="button" class="modal-close" data-close aria-label="Close">✕</button>
				</div>
			</div>
			<script>
				const modal = document.getElementById('proof-modal');
				const proofImg = document.getElementById('proof-img');
				document.querySelectorAll('[data-proof]').forEach((btn) => {
					btn.addEventListener('click', () => {
						if (proofImg) proofImg.src = btn.getAttribute('data-proof') ?? '';
						if (modal) modal.hidden = false;
					});
				});
				modal?.querySelectorAll('[data-close]').forEach((el) => {
					el.addEventListener('click', () => {
						modal.hidden = true;
						if (proofImg) proofImg.src = '';
					});
				});
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && modal && !modal.hidden) {
						modal.hidden = true;
						if (proofImg) proofImg.src = '';
					}
				});
			</script>
		</AdminShell>
	</body>
</html>
