---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdminNav from '../../components/AdminNav.astro';
import AdminLogin from '../../components/AdminLogin.astro';
import { getDatabaseUrl } from '../../lib/env';
import { adminGate } from '../../lib/adminGate';
import { adminConfigured } from '../../lib/auth';
import { listOrders, type PaymentOrder } from '../../lib/db';

export const prerender = false;

const gate = await adminGate(Astro);
if (gate.redirect) return gate.redirect;
const email = gate.email;
const error = Astro.url.searchParams.get('error');
const configured = adminConfigured(Astro);
const msg = Astro.url.searchParams.get('msg') ?? '';
const notices: Record<string, string> = {
	done: '✅ License marked done — the customer can now see their bot username and password in their dashboard.',
	saved: 'Bot login saved (not marked done yet — the customer cannot see it).',
	creds: '⚠️ To mark a license done, both the bot username and password are required.',
	reopened: 'License re-opened — the credentials are hidden from the customer again.',
	error: '⚠️ Something went wrong — please try again.',
};

let orders: PaymentOrder[] = [];
let dbError = '';
if (email) {
	const dbUrl = getDatabaseUrl(Astro);
	if (!dbUrl) {
		dbError = 'The database is not configured on the server yet (DATABASE_URL).';
	} else {
		try {
			const all = await listOrders(dbUrl, 200);
			orders = all
				.filter((o) => o.status === 'confirmed')
				.sort((a, b) => Number(!!a.fulfilled_at) - Number(!!b.fulfilled_at));
		} catch {
			dbError = 'Could not read orders from the database.';
		}
	}
}

const fmt = (iso: string) =>
	new Date(iso).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });

const title = 'Bot Licenses (Admin)';
const description = 'Assign the bot username and password for confirmed orders.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.card {
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.4em 1.6em;
				box-shadow: var(--box-shadow);
				margin-bottom: 1.4em;
			}
			.card h2 {
				margin-top: 0;
				font-size: 1.25em;
			}
			.meta {
				color: rgb(var(--gray-dark));
				font-size: 0.93em;
			}
			.badge {
				display: inline-block;
				font-size: 0.78em;
				font-weight: 700;
				border-radius: 999px;
				padding: 0.15em 0.8em;
			}
			.badge.done {
				background: #dcfce7;
				color: #166534;
			}
			.badge.waiting {
				background: #fef3c7;
				color: #92400e;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
				gap: 0.9em;
				margin: 1em 0;
			}
			.field label {
				display: block;
				font-weight: 600;
				font-size: 0.9em;
				margin-bottom: 0.3em;
			}
			.field input {
				width: 100%;
				font: inherit;
				font-size: 0.95em;
				padding: 0.55em 0.7em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 9px;
				background: var(--bg);
				box-sizing: border-box;
			}
			.check {
				display: inline-flex;
				align-items: center;
				gap: 0.45em;
				font-weight: 600;
				margin-right: 1em;
			}
			.btn {
				font: inherit;
				font-weight: 700;
				background: var(--accent);
				color: #fff;
				border: 1px solid var(--accent);
				border-radius: 999px;
				padding: 0.6em 1.4em;
				cursor: pointer;
			}
			.btn.ghost {
				background: var(--surface);
				color: var(--accent-dark);
			}
			.notice {
				border-radius: 10px;
				padding: 0.8em 1em;
				font-weight: 600;
				background: #ffedd5;
				color: #9a3412;
				border: 1px solid #fdba74;
			}
			.errorbox {
				border-radius: 10px;
				padding: 0.8em 1em;
				font-weight: 600;
				background: #fee2e2;
				color: #991b1b;
				border: 1px solid #fca5a5;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="wrap">
			{!email ? (
				<AdminLogin error={error} configured={configured} />
			) : (
				<>
					<AdminNav active="licenses" email={email} />
					<h1>Bot Licenses</h1>
					<p>
						Confirmed orders appear here. Enter the bot username and password you created for
						the customer and tick <strong>“Mark done”</strong> — only then are the credentials
						shown in the customer's dashboard, with their package, devices and days remaining.
					</p>
					{notices[msg] && <p class="notice">{notices[msg]}</p>}
					{dbError && <p class="errorbox">{dbError}</p>}
					{email && !dbError && orders.length === 0 && (
						<p>No confirmed orders yet — licenses to assign will appear here.</p>
					)}
					{orders.map((o) => (
						<section class="card">
							<h2>
								{o.package_label}{' '}
								<span class={`badge ${o.fulfilled_at ? 'done' : 'waiting'}`}>
									{o.fulfilled_at ? '✅ Done — visible to customer' : '⏳ Awaiting assignment'}
								</span>
							</h2>
							<p class="meta">
								<strong>{o.customer_name}</strong> · {o.email}
								{o.contact ? ` · ${o.contact}` : ''} · Order <code>{o.id}</code> · Confirmed{' '}
								{fmt(o.updated_at)}
								{o.fulfilled_at ? ` · Assigned ${fmt(o.fulfilled_at)}` : ''}
							</p>
							<form method="post" action="/api/admin/license">
								<input type="hidden" name="id" value={o.id} />
								<div class="grid">
									<div class="field">
										<label for={`u-${o.id}`}>Bot username</label>
										<input id={`u-${o.id}`} name="bot_username" type="text" value={o.bot_username ?? ''} autocomplete="off" />
									</div>
									<div class="field">
										<label for={`p-${o.id}`}>Bot password</label>
										<input id={`p-${o.id}`} name="bot_password" type="text" value={o.bot_password ?? ''} autocomplete="off" />
									</div>
								</div>
								<label class="check">
									<input type="checkbox" name="done" value="1" checked={!!o.fulfilled_at} />
									Mark done (show these credentials to the customer)
								</label>
								<button class="btn" type="submit">Save</button>
								{o.fulfilled_at && (
									<button
										class="btn ghost"
										type="submit"
										name="action"
										value="unfulfill"
										formaction="/api/admin/license"
									>
										Re-open
									</button>
								)}
							</form>
						</section>
					))}
				</>
			)}
			</div>
		</main>
		<Footer />
	</body>
</html>
