---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
	SHOT_GENERAL,
	SHOT_YOUTUBE,
	SHOT_ADS,
	SHOT_BROWSER,
	SHOT_BROWSER_FP,
	SHOT_BROWSER_DROPDOWN,
	SHOT_PROXIES,
	SHOT_PROXIES_NO,
	SHOT_LAUNCHER,
	SHOT_LOGIN,
} from '../data/screenshots';

const title = 'YTCPM Bot — Installation and Setup Guide';
const description =
	'Beginner-friendly installation and setup guide for YTCPM Bot: download, extract, first launch, login, every settings tab, timing, troubleshooting, and responsible use.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			/* Instructions page only — uses the site's existing design tokens.
			   No global styles are changed. */
			.eyebrow {
				font-size: 0.75em;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 0.5em;
			}
			.lead {
				font-size: 1.15em;
			}
			section {
				margin-bottom: 2.5em;
			}
			.card {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1em 1.1em;
				background: #fff;
				margin-top: 1em;
			}
			.card h3 {
				font-size: 1.1em;
				margin-bottom: 0.4em;
			}
			.note {
				border-left: 4px solid var(--accent);
				background: rgba(var(--gray-light), 35%);
				border-radius: 0 12px 12px 0;
				padding: 1em 1.2em;
				margin-top: 1em;
			}
			.note p {
				margin: 0;
			}
			.warn {
				border: 1px solid rgb(var(--gray-light));
				border-left: 4px solid #b91c1c;
				background: rgba(var(--gray-light), 25%);
				border-radius: 0 12px 12px 0;
				padding: 1em 1.2em;
				margin-top: 1em;
			}
			.warn p {
				margin: 0;
			}
			table.info {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.9em;
				margin-top: 1em;
			}
			table.info th,
			table.info td {
				text-align: left;
				padding: 0.5em 0.75em;
				border: 1px solid rgb(var(--gray-light));
				vertical-align: top;
			}
			table.info th {
				width: 34%;
				background: rgba(var(--gray-light), 35%);
				color: rgb(var(--black));
			}
			table.info td.shown {
				width: 22%;
				white-space: nowrap;
			}
			.shot {
				margin: 1em 0 0;
			}
			.shot img {
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				width: 100%;
				height: auto;
			}
			.shot figcaption {
				font-size: 0.85em;
				color: rgb(var(--gray));
				text-align: center;
				margin-top: 0.5em;
			}
			.toc {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1em 1.2em;
				background: rgba(var(--gray-light), 25%);
			}
			.toc ol {
				margin: 0;
			}
			.actions {
				display: flex;
				gap: 0.75em;
				flex-wrap: wrap;
				margin-top: 1.25em;
			}
			.btn {
				display: inline-block;
				padding: 0.45em 1.1em;
				border-radius: 999px;
				font-weight: 700;
				font-size: 0.85em;
				text-decoration: none;
				border: 2px solid var(--accent);
			}
			.btn-primary {
				background: var(--accent);
				color: #fff;
			}
			.btn-primary:hover {
				color: #fff;
				background: var(--accent-dark);
				border-color: var(--accent-dark);
			}
			.btn-ghost {
				color: var(--accent);
				background: transparent;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="wrap">
			<section aria-labelledby="guide-heading">
				<p class="eyebrow">Setup Guide</p>
				<h1 id="guide-heading">YTCPM Bot — Installation and Setup Guide</h1>
				<p class="lead">
					This beginner-friendly guide takes you from download to a running bot: what to
					download, how to extract it, what happens on first launch, how signing in works, and
					what every setting in the bot means.
				</p>
				<div class="toc">
					<strong>On this page</strong>
					<ol>
						<li><a href="#step-1">Download the bot</a></li>
						<li><a href="#step-2">Extract the ZIP file</a></li>
						<li><a href="#step-3">No installation needed</a></li>
						<li><a href="#step-4">First-time startup and sign-in</a></li>
						<li><a href="#step-5">How long does the first run take?</a></li>
						<li><a href="#step-6">Configure the bot (every settings tab)</a></li>
						<li><a href="#step-7">Run the bot and understand results</a></li>
						<li><a href="#troubleshooting">Troubleshooting</a></li>
						<li><a href="#security">Security and responsible use</a></li>
					</ol>
				</div>
			</section>

			<!-- Step 1 -->
			<section id="step-1" aria-labelledby="step-1-heading">
				<h2 id="step-1-heading">Step 1: Download the Bot</h2>
				<ol>
					<li>Go to the <a href="/download">download page</a>.</li>
					<li>
						Click <strong>Download YTCPM Bot</strong>. Your browser downloads
						<code>YoutubeCPM.zip</code> (17.0&nbsp;MB).
					</li>
					<li>
						If the browser asks where to save it, choose a folder you can find again — the
						Windows <strong>Downloads</strong> folder is fine.
					</li>
					<li>Wait until the download finishes completely before continuing.</li>
				</ol>
				<p>
					<strong>Finding the file afterwards:</strong> press <code>Ctrl + J</code> in your
					browser to open its Downloads list, or open File Explorer and click
					<strong>Downloads</strong> in the left sidebar. Look for <code>YoutubeCPM.zip</code>.
				</p>
				<div class="note">
					<p>
						<strong>Optional check:</strong> verify the file is genuine and complete. In the
						Downloads folder, run
						<code>certutil -hashfile YoutubeCPM.zip SHA256</code> in a terminal and compare it
						with the SHA-256 checksum published on the <a href="/download">download page</a>.
					</p>
				</div>
			</section>

			<!-- Step 2 -->
			<section id="step-2" aria-labelledby="step-2-heading">
				<h2 id="step-2-heading">Step 2: Extract the ZIP File</h2>
				<ol>
					<li>Locate <code>YoutubeCPM.zip</code> in your Downloads folder.</li>
					<li>Right-click the archive and select <strong>Extract All…</strong></li>
					<li>Choose a destination folder (the suggested folder is fine) and click <strong>Extract</strong>.</li>
					<li>Open the extracted folder.</li>
					<li>
						Go into the <strong><code>YoutubeCPM</code></strong> folder inside it — that is
						where the application lives.
					</li>
				</ol>
				<p>After extraction you should see this structure:</p>
				<ul>
					<li>
						<code>YoutubeCPM</code> folder containing <code>YoutubeCPM.exe</code>, its library
						(.dll) files, and subfolders such as <code>data</code>, <code>platforms</code>, and
						<code>translations</code>.
					</li>
					<li>
						Next to that folder: <code>List_of_Refrences.txt</code>,
						<code>User_Agents.txt</code>, and <code>proxy.txt</code>.
					</li>
				</ul>
				<p>
					You can also edit <code>List_of_Refrences.txt</code> and <code>User_Agents.txt</code>
					yourself, or replace them with your own files — the rule is simply
					<strong>one entry per line</strong>: one reference website per line, one user agent
					per line. The same rule applies to <code>proxy.txt</code> (one proxy per line).
					Details are in <a href="#step-6">Step 6</a>.
				</p>
				<div class="warn">
					<p>
						<strong>Do not run the bot from inside the ZIP archive.</strong> Always extract
						first, and keep the folder structure exactly as extracted — do not move
						<code>YoutubeCPM.exe</code> away from its .dll files, and do not delete the three
						text files, because the bot's settings point to them.
					</p>
				</div>
			</section>

			<!-- Step 3 -->
			<section id="step-3" aria-labelledby="step-3-heading">
				<h2 id="step-3-heading">Step 3: No Installation Needed</h2>
				<p>
					<strong>There is nothing to install.</strong> YTCPM Bot is a ready-to-run package:
					you simply run <code>YoutubeCPM.exe</code> (Step 4), and on first launch it
					downloads the additional files it needs by itself. There is no setup wizard, no
					project file to open, and no other software required for anything in this guide —
					if the download and extraction from Steps 1–2 are done, you are ready to configure
					the bot.
				</p>
			</section>

			<!-- Step 4 -->
			<section id="step-4" aria-labelledby="step-4-heading">
				<h2 id="step-4-heading">Step 4: First-Time Startup and Sign-In</h2>
				<ol>
					<li>
						From the extracted folder, open the inner <code>YoutubeCPM</code> folder and
						double-click <strong><code>YoutubeCPM.exe</code></strong> inside it. (The text
						files stay next to that folder — do not move them.)
					</li>
					<li>
						The <strong>Script launcher</strong> window appears: “Downloading engine — The
						script will start automatically when it is ready.” On first run it downloads
						up to <strong>2.0&nbsp;GB</strong> of engine files in the background.
						<strong>Wait for it to finish — do not close the launcher.</strong> You can watch
						the progress bar and percentage; click <em>Cancel</em> only if you want to stop.
					</li>
					<figure class="shot">
						<img src={SHOT_LAUNCHER} width="555" height="244" loading="lazy" alt="Script launcher window showing Downloading engine with a progress bar" />
						<figcaption>The Script launcher window you will see on first run.</figcaption>
					</figure>
					<li>
						When the download completes, the script starts by itself and a window titled
						<strong>Please enter credentials</strong> asks for your <strong>Login</strong> and
						<strong>Password</strong>.
					</li>
					<li>
						Enter the login and password provided with your access in the
						<strong>Login</strong> and <strong>Password</strong> fields. If you want the bot to
						remember them on this computer, tick <strong>Save Pass On Disk</strong>.
					</li>
					<figure class="shot">
						<img src={SHOT_LOGIN} width="474" height="237" loading="lazy" alt="Please enter credentials window with Login and Password fields and the Save Pass On Disk checkbox" />
						<figcaption>The “Please enter credentials” window.</figcaption>
					</figure>
					<li>
						Click <strong>OK</strong>. The bot checks the username and password — if they are
						correct, the main window opens. If they are rejected, re-check for typing errors
						and try again.
					</li>
					<li>
						Complete the settings window (<a href="#step-6">Step 6</a>) and click
						<strong>OK</strong> to run.
					</li>
				</ol>
				<h3>One-time vs every time</h3>
				<ul>
					<li>
						<strong>First run only:</strong> the up to 2.0&nbsp;GB engine download, and (if you
						ticked Save) storing your sign-in.
					</li>
					<li>
						<strong>Every run:</strong> launch <code>YoutubeCPM.exe</code>, sign in (if not
						saved), confirm the settings, click OK.
					</li>
				</ul>
			</section>

			<!-- Step 5 -->
			<section id="step-5" aria-labelledby="step-5-heading">
				<h2 id="step-5-heading">Step 5: How Long Does the First Run Take?</h2>
				<p>
					These are planning estimates, not guarantees — your connection and computer decide
					the real times:
				</p>
				<table class="info">
					<tbody>
						<tr>
							<th scope="row">Downloading the package</th>
							<td>About 1–5 minutes on typical broadband — the archive is only 17.0&nbsp;MB.</td>
						</tr>
						<tr>
							<th scope="row">Extracting the ZIP</th>
							<td>About 1–3 minutes.</td>
						</tr>
						<tr>
							<th scope="row">Installing anything</th>
							<td>Not needed — there is nothing to install (see Step 3).</td>
						</tr>
						<tr>
							<th scope="row">First-run engine download</th>
							<td>
								The big one: up to 2.0&nbsp;GB downloads in the background after you first
								run <code>YoutubeCPM.exe</code>. On a fast connection this can be a few
								minutes; on a slow connection (around 10&nbsp;Mbps) it can take 15–25
								minutes or longer.
							</td>
						</tr>
						<tr>
							<th scope="row">Initial configuration</th>
							<td>About 3–10 minutes if your sign-in details and any proxy list are ready.</td>
						</tr>
						<tr>
							<th scope="row">First execution</th>
							<td>Varies with the workflow, browser startup, network speed, and the settings you chose (browsers, total views, delays).</td>
						</tr>
					</tbody>
				</table>
				<p>
					Altogether, a straightforward setup takes around <strong>10–30 minutes</strong>,
					excluding a slow first-run engine download, which can extend the first launch
					beyond that. Later launches are faster: the engine is already downloaded and your
					sign-in and settings do not need to be set up again.
				</p>
				<div class="note">
					<p>
						There is no guaranteed execution or completion time for a run — it depends on
						your settings (for example, number of browsers and total views) and network
						conditions.
					</p>
				</div>
			</section>

			<!-- Step 6 -->
			<section id="step-6" aria-labelledby="step-6-heading">
				<h2 id="step-6-heading">Step 6: Configure the Bot</h2>
				<p>
					When the bot starts, it opens a settings window titled
					<strong>Please define resources</strong>. Work through the tabs below, then click
					<strong>OK</strong> to continue (or <strong>Cancel</strong> to stop). The values in
					the “Shown as” column are the values from the reference screenshots — treat them as
					starting points, not recommendations.
				</p>

				<article class="card">
					<h3>General</h3>
					<table class="info">
						<tbody>
							<tr>
								<th scope="row">Number of Browsers</th>
								<td>
									How many browser instances the bot runs in parallel. <strong>Set this for
									your PC's RAM: each browser uses about 2&nbsp;GB.</strong> For example,
									keep it around 3 on an 8&nbsp;GB PC and around 6 on a 16&nbsp;GB PC, so
									Windows still has room; 10 (as shown) suits high-RAM PCs (32&nbsp;GB).
								</td>
								<td class="shown">10</td>
							</tr>
							<tr>
								<th scope="row">Sleep between every page load, in seconds</th>
								<td>
									A random pause between the minimum and maximum values, applied between
									page loads. These values are set by the developer as the recommended
									minimum — <strong>you can increase them</strong> if your internet or
									proxies are slow (slower connections usually need a longer sleep), but
									keep at least 3 and 5.
								</td>
								<td class="shown">Min 3 · Max 5</td>
							</tr>
							<tr>
								<th scope="row">List of Refrences Websites</th>
								<td>
									Click the folder button and attach the <code>List_of_Refrences.txt</code>
									file from the folder you extracted in Step 2 — it sits next to the
									<code>YoutubeCPM</code> folder. These references are the websites your
									traffic will appear to come from. You can edit this file or use your
									own — <strong>one website per line</strong>.
								</td>
								<td class="shown">Bundled file</td>
							</tr>
							<tr>
								<th scope="row">Total Views</th>
								<td>The total number of views the workflow is set to work towards.</td>
								<td class="shown">9999999</td>
							</tr>
						</tbody>
					</table>
				</article>

				<figure class="shot">
					<img src={SHOT_GENERAL} width="920" height="668" loading="lazy" alt="YTCPM Bot main window showing the General settings tab" />
					<figcaption>General settings in the bot's main window.</figcaption>
				</figure>

				<article class="card">
					<h3>Youtube Setting</h3>
					<table class="info">
						<tbody>
							<tr>
								<th scope="row">Enable Skip Ads</th>
								<td>Whether the bot skips ads when YouTube offers a skip option (<em>Yes</em> / <em>No</em>).</td>
								<td class="shown">Yes</td>
							</tr>
						</tbody>
					</table>
				</article>

				<figure class="shot">
					<img src={SHOT_YOUTUBE} width="915" height="647" loading="lazy" alt="Youtube Setting tab showing Enable Skip Ads set to Yes" />
					<figcaption>Youtube Setting tab.</figcaption>
				</figure>

				<article class="card">
					<h3>Ads Setting</h3>
					<table class="info">
						<tbody>
							<tr>
								<th scope="row">Enable Ads</th>
								<td>Turn ads handling in the workflow on or off (<em>Yes</em> / <em>No</em>).</td>
								<td class="shown">Yes</td>
							</tr>
							<tr>
								<th scope="row">Select Ads Type</th>
								<td>Which ads type the workflow works with.</td>
								<td class="shown">DisplayAds</td>
							</tr>
							<tr>
								<th scope="row">Enable Scroll 4 Ads</th>
								<td>Whether the page is scrolled for ads (<em>Yes</em> / <em>No</em>).</td>
								<td class="shown">Yes</td>
							</tr>
							<tr>
								<th scope="row">Open Ads Internal page</th>
								<td>Whether the ads internal (landing) page is opened (<em>Yes</em> / <em>No</em>).</td>
								<td class="shown">Yes</td>
							</tr>
							<tr>
								<th scope="row">Time Duration for Ads, in Seconds</th>
								<td>A random duration between the minimum and maximum values for how long ads are shown.</td>
								<td class="shown">Min 30 · Max 50</td>
							</tr>
						</tbody>
					</table>
				</article>

				<figure class="shot">
					<img src={SHOT_ADS} width="916" height="666" loading="lazy" alt="Ads Setting tab showing enable ads, ads type, scroll and duration settings" />
					<figcaption>Ads Setting tab.</figcaption>
				</figure>

				<article class="card">
					<h3>Browser</h3>
					<table class="info">
						<tbody>
							<tr>
								<th scope="row">Enable Fingerprint, Premium Service</th>
								<td>
									Your choice of two modes (both are shown in the screenshots below):
									<ul>
										<li>
											<strong>No</strong> — the bot uses the user-agents list file instead:
											set <em>Select User Agents</em> (below) and link the
											<code>User_Agents.txt</code> file from the extracted folder. With
											<em>No</em>, setting up user agents is <strong>required</strong>.
										</li>
										<li>
											<strong>Yes</strong> — the bot uses the premium fingerprint service
											instead, and <em>Select User Agents</em> switches to <em>Off</em>. This
											needs a <strong>Fingerprint API Key</strong> (see below), and user
											agents do not need to be set.
										</li>
									</ul>
								</td>
								<td class="shown">No</td>
							</tr>
							<tr>
								<th scope="row">Fingerprint API Key (only if Fingerprint = Yes)</th>
								<td>
									<strong>Required when fingerprint is enabled</strong> — the red
									<strong>!</strong> beside the Browser tab means it is missing. This is a
									paid premium service: <strong>$30 per month</strong>, and per the developer
									it allows up to <strong>100 threads per minute</strong>. The key must be
									<strong>valid and working</strong> — with a missing or non-working key,
									the browser/bot keeps failing with errors. Keep your key private; never
									share it publicly.
								</td>
								<td class="shown">Paid key</td>
							</tr>
							<tr>
								<th scope="row">Fingerprint Device Type (only if Fingerprint = Yes)</th>
								<td>The device type the fingerprint service should imitate.</td>
								<td class="shown">Mobile</td>
							</tr>
							<tr>
								<th scope="row">Select User Agents</th>
								<td>
									Four options (see the dropdown screenshot below):
									<ul>
										<li>
											<strong>Off</strong> — the one built-in default user agent is used.
											This is also what the setting switches to when Fingerprint is
											<em>Yes</em>.
										</li>
										<li>
											<strong>Auto</strong> — paste the link of a web page that lists user
											agents into the field above; the bot loads the user agents from
											that page.
										</li>
										<li>
											<strong>List Mix</strong> — the bot mixes the user agents from your
											file itself: any browser can receive any user agent, and repeats
											are possible. This works per run — stop and start the task again
											and the bot starts mixing from the beginning.
										</li>
										<li>
											<strong>List Unique</strong> — each line of your file is used only
											<strong>once</strong> per run: a user agent is never repeated
											until you stop the task and start it again.
										</li>
									</ul>
								</td>
								<td class="shown">List Mix</td>
							</tr>
							<tr>
								<th scope="row">User Agents File Mix</th>
								<td>
									Select the <code>User_Agents.txt</code> file from the same extracted
									folder (it contains 999 user-agent strings). Used with <em>List Mix</em>
									and <em>List Unique</em> when Fingerprint is <em>No</em>. You can edit
									this file or use your own — <strong>one user agent per line</strong>.
									User-agent lists can also be downloaded from the internet; which file
									you use is your choice.
								</td>
								<td class="shown">Bundled file</td>
							</tr>
						</tbody>
					</table>
				</article>

				<figure class="shot">
					<img src={SHOT_BROWSER} width="920" height="660" loading="lazy" alt="Browser tab with fingerprint off, user agents set to List Mix and the User Agents file linked" />
					<figcaption>Browser tab with Fingerprint off — the User_Agents.txt file is used.</figcaption>
				</figure>
				<figure class="shot">
					<img src={SHOT_BROWSER_FP} width="915" height="663" loading="lazy" alt="Browser tab with fingerprint premium service on, showing the API key field and device type, and user agents off" />
					<figcaption>Browser tab with Fingerprint on — an API key is required (red !) and user agents are off.</figcaption>
				</figure>
				<figure class="shot">
					<img src={SHOT_BROWSER_DROPDOWN} width="919" height="671" loading="lazy" alt="Browser tab with the Select User Agents menu open, showing the Off, Auto, List Mix and List Unique options" />
					<figcaption>The four Select User Agents options: Off, Auto, List Mix and List Unique.</figcaption>
				</figure>

				<article class="card">
					<h3>Proxies</h3>
					<table class="info">
						<tbody>
							<tr>
								<th scope="row">Want to Used Proxies?</th>
								<td>
									Turn proxy use on or off (<em>Yes</em> / <em>No</em>). With <em>No</em>, the
									bot simply uses <strong>your own internet connection's IP</strong> — or
									whatever IP, VPN or proxy is active on your whole system — and the rest
									of this tab is not needed (see the screenshot below). With <em>Yes</em>,
									fill in the fields below.
								</td>
								<td class="shown">Yes</td>
							</tr>
							<tr>
