---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { baSessionUser } from '../lib/baSession';

export const prerender = false;

const user = await baSessionUser(Astro);
if (user) return Astro.redirect('/account');

const next = Astro.url.searchParams.get('next') ?? '';
const errorCode = Astro.url.searchParams.get('error') ?? '';
const errors: Record<string, string> = {
	username: 'Please choose a username: 3–24 characters, letters, numbers, dot, dash or underscore.',
	'username-taken': 'This username is already taken — please choose another one.',
	email: 'Please enter a valid email address.',
	'email-taken': 'An account with this email already exists — sign in instead.',
	fullname: 'Please enter your full name.',
	country: 'Please enter your country.',
	state: 'Please enter your state / province.',
	city: 'Please enter your city.',
	address: 'Please enter your full address.',
	zip: 'Please enter a valid ZIP / postal code.',
	whatsapp: 'Please enter a valid WhatsApp number with country code (e.g. +1 555 123 4567).',
	'whatsapp-taken': 'This WhatsApp number is already registered — sign in instead, or use another number.',
	telegram: 'Please enter a valid Telegram username (5–32 characters, letters, numbers or underscore).',
	'telegram-taken': 'This Telegram username is already registered to another account.',
	password: 'Please choose a password of at least 8 characters.',
	exists: 'An account with this email already exists — sign in instead.',
	invalid: 'The sign-up could not be completed. Please check the details and try again.',
	server: 'Accounts are having a problem right now. Please try again in a little while.',
};
const error = errors[errorCode] ?? '';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Create an account — ${SITE_TITLE}`}
			description="Create a free YTCPM account to track your licenses, purchase dates, expiry and order status in one dashboard."
		/>
		<style>
			main {
				padding: 2.6em 1em 0;
			}
			.card {
				max-width: 680px;
				margin: 0 auto;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.8em 1.9em;
				box-shadow: var(--box-shadow);
			}
			.card h1 {
				font-size: 1.7em;
				margin-bottom: 0.25em;
			}
			.card .sub {
				color: rgb(var(--gray-dark));
				font-size: 0.95em;
				margin-bottom: 1.3em;
			}
			.notice {
				border-radius: 10px;
				padding: 0.8em 1em;
				margin-bottom: 1.1em;
				font-weight: 600;
				font-size: 0.93em;
				background: #fee2e2;
				color: #991b1b;
				border: 1px solid #fca5a5;
			}
			form {
				display: grid;
				gap: 1em;
			}
			.grid2 {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1em;
			}
			.req {
				color: var(--accent-dark);
			}
			.hint {
				font-size: 0.82em;
				color: rgb(var(--gray));
				margin-top: 0.3em;
			}
			@media (max-width: 640px) {
				.grid2 {
					grid-template-columns: 1fr;
				}
			}
			.field label {
				display: block;
				font-weight: 600;
				font-size: 0.92em;
				margin-bottom: 0.35em;
			}
			.field input {
				width: 100%;
				font: inherit;
				font-size: 0.97em;
				padding: 0.6em 0.75em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 9px;
				background: var(--bg);
				box-sizing: border-box;
			}
			.field input:focus {
				outline: 2px solid var(--accent);
				outline-offset: 1px;
				border-color: var(--accent);
			}
			button.go {
				font: inherit;
				font-weight: 700;
				background: var(--accent);
				color: #fff;
				border: none;
				border-radius: 999px;
				padding: 0.75em 1.6em;
				cursor: pointer;
			}
			button.go:hover {
				background: var(--accent-dark);
			}
			.alt {
				margin-top: 1.2em;
				font-size: 0.93em;
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="card">
				<h1>Create your account</h1>
				<p class="sub">
					One account for all your licenses — purchase dates, expiry and order
					status in one place. Fields marked <span class="req">*</span> are required.
					After registering we email you a verification link — please verify your
					email before your first purchase.
				</p>
				{error && <p class="notice">{error}</p>}
				<form method="post" action="/api/account/signup">
					{next && <input type="hidden" name="next" value={next} />}
					<div class="grid2">
						<div class="field">
							<label for="f-username">Username <span class="req">*</span></label>
							<input id="f-username" name="username" type="text" required maxlength="24" autocomplete="username" />
						</div>
						<div class="field">
							<label for="f-fullname">Full name <span class="req">*</span></label>
							<input id="f-fullname" name="fullName" type="text" required maxlength="80" autocomplete="name" />
						</div>
					</div>
					<div class="grid2">
						<div class="field">
							<label for="f-email">Email address <span class="req">*</span></label>
							<input id="f-email" name="email" type="email" required maxlength="160" autocomplete="email" />
						</div>
						<div class="field">
							<label for="f-password">Password <span class="req">*</span></label>
							<input id="f-password" name="password" type="password" required minlength="8" maxlength="128" autocomplete="new-password" />
							<p class="hint">At least 8 characters.</p>
						</div>
					</div>
					<div class="grid2">
						<div class="field">
							<label for="f-whatsapp">WhatsApp <span class="req">*</span></label>
							<input id="f-whatsapp" name="whatsapp" type="tel" required maxlength="24" autocomplete="tel" placeholder="+1 555 123 4567" />
							<p class="hint">With country code — the admin reaches you here.</p>
						</div>
						<div class="field">
							<label for="f-telegram">Telegram</label>
							<input id="f-telegram" name="telegram" type="text" maxlength="36" autocomplete="off" placeholder="@username" />
						</div>
					</div>
					<div class="field">
						<label for="f-address">Address <span class="req">*</span></label>
						<input id="f-address" name="address" type="text" required maxlength="160" autocomplete="street-address" />
					</div>
					<div class="grid2">
						<div class="field">
							<label for="f-city">City <span class="req">*</span></label>
							<input id="f-city" name="city" type="text" required maxlength="60" autocomplete="address-level2" />
						</div>
						<div class="field">
							<label for="f-state">State / Province <span class="req">*</span></label>
							<input id="f-state" name="state" type="text" required maxlength="60" autocomplete="address-level1" />
						</div>
					</div>
					<div class="grid2">
						<div class="field">
							<label for="f-zip">ZIP code <span class="req">*</span></label>
							<input id="f-zip" name="zip" type="text" required maxlength="12" autocomplete="postal-code" />
						</div>
						<div class="field">
							<label for="f-country">Country <span class="req">*</span></label>
							<input id="f-country" name="country" type="text" required maxlength="60" autocomplete="country-name" />
						</div>
					</div>
					<button class="go" type="submit">Create account</button>
				</form>
				<p class="alt">
					Already have an account? <a href={next ? `/login?next=${encodeURIComponent(next)}` : '/login'}>Sign in</a>.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
