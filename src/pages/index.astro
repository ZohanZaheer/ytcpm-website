---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Features from '../components/home/Features.astro';
import Showcase from '../components/home/Showcase.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import PricingStrip from '../components/home/PricingStrip.astro';
import Faq from '../components/home/Faq.astro';
import CtaBand from '../components/home/CtaBand.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getEnv, getDatabaseUrl } from '../lib/env';
import { getEffectiveSettings, activePackages } from '../lib/settings';
import { SHOT_GENERAL } from '../data/screenshots';

// Rendered per request so prices and the bot version shown here always
// match the admin dashboard settings.
export const prerender = false;

const settings = await getEffectiveSettings(getDatabaseUrl(Astro), (k) => getEnv(Astro, k));
const all = activePackages(settings);
const featured = [
	...all.filter((p) => p.popular),
	...all.filter((p) => !p.popular).sort((a, b) => a.priceUsd - b.priceUsd),
].slice(0, 3);
const fromPrice = all.length ? Math.min(...all.map((p) => p.priceUsd)) : 500;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — YouTube CPM Automation for Windows`} description={SITE_DESCRIPTION} />
		<style>
			/* Homepage only: sections manage their own spacing. */
			main {
				padding-top: 0;
				padding-bottom: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<Hero version={settings.download.version} fromPrice={fromPrice} shot={SHOT_GENERAL} />
			<Features />
			<Showcase />
			<HowItWorks />
			<PricingStrip packages={featured} />
			<Faq />
			<CtaBand version={settings.download.version} />
		</main>
		<Footer />
	</body>
</html>
