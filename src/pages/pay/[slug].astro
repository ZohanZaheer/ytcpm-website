---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { formatUsd, CRYPTOS, type CryptoCode } from '../../lib/packages';
import { getEnv, getDatabaseUrl } from '../../lib/env';
import { getEffectiveSettings, findPackage, resolveSlug, availableMethods, type PaymentMethod } from '../../lib/settings';
import { baSessionUser, verificationEnforced } from '../../lib/baSession';
import QRCode from 'qrcode';

export const prerender = false;

// Package, price and payment values come from the effective site
// settings (saved in the database from the admin dashboard), so
// dashboard edits apply to checkout immediately.
const settings = await getEffectiveSettings(getDatabaseUrl(Astro), (k) => getEnv(Astro, k));
const requestedSlug = Astro.params.slug ?? '';
const pkg = findPackage(settings, requestedSlug);
if (!pkg) {
	// The link name may have been renamed in the dashboard — forward
	// the old link to the package's current name.
	const target = resolveSlug(settings, requestedSlug);
	if (target !== requestedSlug && findPackage(settings, target)) {
		return Astro.redirect('/pay/' + target, 302);
	}
	return new Response('Package not found.', { status: 404 });
}

// Checkout requires an account: guests go to sign in / register
// first and come straight back here afterwards.
const buyer = await baSessionUser(Astro);
if (!buyer) {
	return Astro.redirect('/login?next=' + encodeURIComponent('/pay/' + pkg.slug) + '&notice=buy');
}
// …and a verified email (enforced when an email provider is
// configured, so verification links can really be delivered).
const mustVerify = verificationEnforced(Astro) && !buyer.emailVerified;
const verifyState = Astro.url.searchParams.get('verify') ?? '';

const title = `Pay ${formatUsd(pkg.priceUsd)} — ${pkg.duration}, ${pkg.devices} Devices`;
const description = `Pay for your YTCPM Bot license (${pkg.duration}, ${pkg.devices} devices) with crypto, PayPal or card, then submit your payment proof for activation.`;

// Only the methods the admin has enabled AND fully configured are
// offered — a disabled or half-filled method never appears here.
const methods = availableMethods(settings);
const firstMethod = methods[0];
const methodLabel: Record<PaymentMethod, string> = {
	USDT: `USDT (${settings.payments.usdtNetwork})`,
	BTC: 'BTC',
	ETH: 'ETH',
	PayPal: 'PayPal',
	Stripe: 'Card (Stripe)',
};
const stripeHref = settings.payments.stripeLink
	? settings.payments.stripeLink +
		(settings.payments.stripeLink.includes('?') ? '&' : '?') +
		'prefilled_email=' +
		encodeURIComponent(buyer.email)
	: '';

const usdtNetwork = settings.payments.usdtNetwork;
const addresses: Record<CryptoCode, string | undefined> = {
	USDT: settings.payments.usdtAddress || undefined,
	BTC: settings.payments.btcAddress || undefined,
	ETH: settings.payments.ethAddress || undefined,
};
const networkLabel: Record<CryptoCode, string> = {
	USDT: usdtNetwork,
	BTC: 'Bitcoin',
	ETH: 'ERC20',
};

const qrSvg: Partial<Record<CryptoCode, string>> = {};
for (const code of CRYPTOS) {
	const addr = addresses[code];
	if (addr) {
		// SVG output is pure JS — the PNG/canvas build of this library
		// crashes inside Cloudflare Workers ("specify a canvas element").
		qrSvg[code] = await QRCode.toString(addr, { type: 'svg', width: 240, margin: 1 });
	}
}
const anyConfigured = methods.length > 0;
const error = Astro.url.searchParams.get('error');

const exchanges = [
	{ name: 'Binance', url: 'https://www.binance.com' },
	{ name: 'Coinbase', url: 'https://www.coinbase.com' },
	{ name: 'Kraken', url: 'https://www.kraken.com' },
	{ name: 'OKX', url: 'https://www.okx.com' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.eyebrow {
				font-size: 0.75em;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 0.5em;
			}
			section {
				margin-bottom: 2.5em;
			}
			.summary {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1em 1.2em;
				background: rgba(var(--gray-light), 25%);
				display: flex;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.5em 2em;
			}
			.amount {
				font-size: 1.6em;
				font-weight: 700;
				color: var(--accent);
			}
			.coins {
				display: flex;
				gap: 0.5em;
				flex-wrap: wrap;
				margin: 1em 0;
			}
			.coins label {
				border: 2px solid rgb(var(--gray-light));
				border-radius: 999px;
				padding: 0.4em 1.2em;
				font-weight: 700;
				cursor: pointer;
			}
			.coins input {
				position: absolute;
				opacity: 0;
			}
			.coins label:has(input:checked) {
				border-color: var(--accent);
				background: var(--accent);
				color: #fff;
			}
			.coin-panel {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.2em;
				background: #fff;
				text-align: center;
			}
			.coin-panel .qr {
				display: flex;
				justify-content: center;
			}
			.coin-panel .qr svg {
				width: 240px;
				height: 240px;
				border-radius: 8px;
				background: #fff;
			}
			.addr {
				word-break: break-all;
				font-size: 0.85em;
				background: rgb(var(--gray-light));
				border-radius: 8px;
				padding: 0.6em;
				display: block;
				margin: 0.6em 0;
			}
			.field {
				display: block;
				margin-top: 1em;
				font-weight: 700;
				font-size: 0.9em;
			}
			.field input[type='text'],
			.field input[type='email'],
			.field input[type='file'],
			.field textarea {
				width: 100%;
				margin-top: 0.3em;
				padding: 0.5em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				font: inherit;
				font-weight: 400;
			}
			.btn {
				margin-top: 1.5em;
				display: inline-block;
				padding: 0.5em 1.4em;
				border-radius: 999px;
				font-weight: 700;
				border: 2px solid var(--accent);
				background: var(--accent);
				color: #fff;
				cursor: pointer;
				font-size: 0.95em;
			}
			.error {
				border: 1px solid #b91c1c;
				border-left: 4px solid #b91c1c;
				border-radius: 0 12px 12px 0;
				background: rgba(185, 28, 28, 0.06);
				padding: 1em 1.2em;
			}
			.warnbox {
				border-left: 4px solid var(--accent);
				background: rgba(var(--gray-light), 35%);
				border-radius: 0 12px 12px 0;
				padding: 1em 1.2em;
			}
			.exchanges {
				display: flex;
				gap: 0.75em;
				flex-wrap: wrap;
			}
			.exchanges a {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				padding: 0.35em 1.1em;
				text-decoration: none;
				font-weight: 700;
				background: #fff;
			}
			/* The page is full-width; the checkout column itself keeps a
			   readable measure so form fields don't stretch edge to edge. */
			section[aria-labelledby="pay-heading"] {
				max-width: 860px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="wrap">
			<section aria-labelledby="pay-heading">
				<p class="eyebrow">Checkout</p>
				<h1 id="pay-heading">Complete Your Payment</h1>
				<div class="summary" role="note" aria-label="Order summary">
					<span><strong>{pkg.duration}</strong> — {pkg.devices} devices</span>
					<span class="amount">{formatUsd(pkg.priceUsd)}</span>
				</div>
				<p>
					<a href="/pricing">← Choose a different package</a>
				</p>
				<p>
					Paying as <strong>{buyer.name}</strong> ({buyer.email}) — your account details are
					used for the order automatically.
				</p>
				{error && <p class="error" role="alert">{error}</p>}
			</section>

			{
				mustVerify ? (
					<section>
						<div class="warnbox">
							<p style="margin:0 0 0.8em">
								<strong>One step first: verify your email.</strong> We sent a verification
								link to <strong>{buyer.email}</strong>. Open it, then come back — this
								payment page unlocks automatically once your email is verified.
							</p>
							{verifyState === 'sent' && (
								<p>✅ A new verification link has been sent — check your inbox (and the spam folder).</p>
							)}
							{verifyState === 'error' && (
								<p>⚠️ The email could not be sent just now — please try again in a moment.</p>
							)}
							<form method="post" action="/api/account/resend-verification">
								<input type="hidden" name="back" value={'/pay/' + pkg.slug} />
								<button class="btn" type="submit">Resend verification email</button>
							</form>
							<p style="margin-bottom:0">
								<a href={'/pay/' + pkg.slug}>I have verified — refresh this page</a>
							</p>
						</div>
					</section>
				) : !anyConfigured ? (
					<section>
						<div class="warnbox">
							<p style="margin:0">
								<strong>Payment methods are being configured.</strong> No payment
								method is available yet, so checkout is temporarily unavailable.
								Please check back soon or contact support — do not send a payment
								to any address that is not shown on this page.
							</p>
						</div>
					</section>
				) : (
					<form method="post" action="/api/orders" enctype="multipart/form-data">
						<input type="hidden" name="package" value={pkg.slug} />

						<section aria-labelledby="coin-heading">
							<h2 id="coin-heading">1. Choose how to pay</h2>
							<p>
								Pick a payment method — only the selected one is shown. The amount
								to pay is <strong>{formatUsd(pkg.priceUsd)}</strong>.
							</p>
							<div class="coins" role="radiogroup" aria-label="Payment method">
								{methods.map((m, i) => (
									<label>
										<input type="radio" name="crypto" value={m} checked={i === 0} />
										{methodLabel[m]}
									</label>
								))}
							</div>

							{CRYPTOS.filter((code) => methods.includes(code)).map((code) => (
								<div class="coin-panel" data-panel={code} hidden={code !== firstMethod}>
									<div class="qr" role="img" aria-label={`QR code for the ${code} payment address`} set:html={qrSvg[code]} />
									<p style="margin:0.4em 0 0">
										<strong>
											{code} address ({networkLabel[code]})
										</strong>
									</p>
									<code class="addr">{addresses[code]}</code>
									<p style="margin:0">
										<small>
											Send exactly the USD equivalent of {formatUsd(pkg.priceUsd)}
											{code === 'USDT' ? ` — that is ${formatUsd(pkg.priceUsd)} worth of USDT` : ''} on
											the stated network. Double-check the network before sending.
											Crypto payments cannot be reversed.
										</small>
									</p>
								</div>
							))}

							{methods.includes('PayPal') && (
								<div class="coin-panel" data-panel="PayPal" hidden={firstMethod !== 'PayPal'}>
									<p style="margin:0 0 0.4em">
										<strong>PayPal</strong> — send <strong>{formatUsd(pkg.priceUsd)}</strong> to
										this PayPal email:
									</p>
									<code class="addr">{settings.payments.paypalEmail}</code>
									<p style="margin:0">
										<small>
											In the PayPal note, write your account email ({buyer.email}) so we
											can match your payment. Then enter your PayPal transaction ID and
											attach a screenshot of the completed payment below — PayPal orders
											are confirmed manually by the admin.
										</small>
									</p>
								</div>
							)}

							{methods.includes('Stripe') && (
								<div class="coin-panel" data-panel="Stripe" hidden={firstMethod !== 'Stripe'}>
									<p style="margin:0 0 0.6em">
										<strong>Card payment via Stripe</strong> — pay{' '}
										<strong>{formatUsd(pkg.priceUsd)}</strong> on Stripe's secure
										checkout page:
									</p>
									<p style="margin:0 0 0.6em">
										<a class="btn" href={stripeHref} target="_blank" rel="noopener noreferrer">
											Pay {formatUsd(pkg.priceUsd)} with card on Stripe ↗
										</a>
									</p>
									<p style="margin:0">
										<small>
											Use the same email as your account ({buyer.email}) on the Stripe
											page so we can match your payment. After paying, come back here
											and attach a screenshot of your Stripe receipt below.
										</small>
									</p>
								</div>
							)}

							<div data-crypto-note>
								<p>
									Need crypto first? You can buy it on a major exchange — these links open
									in a new tab:
								</p>
								<div class="exchanges">
									{exchanges.map((ex) => (
										<a href={ex.url} target="_blank" rel="noopener noreferrer">
											{ex.name} ↗
										</a>
									))}
								</div>
							</div>
						</section>

						<section aria-labelledby="proof-heading">
							<h2 id="proof-heading">2. Submit your payment proof</h2>
							<p>
								After paying, <strong>take a screenshot of the successful payment</strong>{' '}
								and attach it below with your details. Your order is then verified — while
								your payment is being confirmed, your status page shows “waiting”;
								once it confirms, you will see it there. After confirmation,{' '}
								<strong>our admin will contact you within 24 hours</strong> with your
								license.
							</p>

							<p>
								Your name, email and WhatsApp / Telegram are taken from your account
								(<strong>{buyer.email}</strong>) — the admin reaches you on those.
							</p>
							<label class="field">
								<span id="tx-label">Transaction hash / TXID (recommended — enables automatic confirmation)</span>
								<input id="tx-input" type="text" name="tx_hash" placeholder="Paste the transaction hash from your wallet or exchange" />
							</label>
							<label class="field">
								Payment screenshot * (PNG, JPG or WebP, max 5 MB)
								<input type="file" name="screenshot" accept="image/png,image/jpeg,image/webp" required />
							</label>
							<label class="field">
								Note (optional)
								<textarea name="note" rows="2" />
							</label>

							<button class="btn" type="submit">
								I have paid — submit screenshot &amp; details
							</button>
							<p>
								<small>
									100% payment in advance. License activation begins after payment
									confirmation.
								</small>
							</p>
						</section>
					</form>
				)
			}
			</div>
		</main>
		<Footer />
		<script is:inline>
			const radios = document.querySelectorAll('input[name="crypto"]');
			const panels = document.querySelectorAll('[data-panel]');
			const cryptoNote = document.querySelector('[data-crypto-note]');
			const txLabel = document.getElementById('tx-label');
			const txInput = document.getElementById('tx-input');
			const txText = {
				USDT: ['Transaction hash / TXID (recommended — enables automatic confirmation)', 'Paste the transaction hash from your wallet or exchange'],
				BTC: ['Transaction hash / TXID (recommended — enables automatic confirmation)', 'Paste the transaction hash from your wallet or exchange'],
				ETH: ['Transaction hash / TXID (recommended — enables automatic confirmation)', 'Paste the transaction hash from your wallet or exchange'],
				PayPal: ['PayPal transaction ID (recommended)', 'Paste the transaction ID from your PayPal payment'],
				Stripe: ['Stripe payment ID (optional)', 'Paste the payment ID from your Stripe receipt email'],
			};
			function sync() {
				const selected = document.querySelector('input[name="crypto"]:checked')?.value;
				panels.forEach((p) => {
					p.hidden = p.getAttribute('data-panel') !== selected;
				});
				const isCrypto = selected === 'USDT' || selected === 'BTC' || selected === 'ETH';
				if (cryptoNote) cryptoNote.hidden = !isCrypto;
				const t = txText[selected];
				if (t && txLabel && txInput) {
					txLabel.textContent = t[0];
					txInput.placeholder = t[1];
				}
			}
			radios.forEach((r) => r.addEventListener('change', sync));
			sync();
		</script>
	</body>
</html>
