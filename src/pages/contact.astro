---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { CONTACT_TOPICS } from './api/contact';

export const prerender = false;

const sent = Astro.url.searchParams.get('sent') === '1';
const errorCode = Astro.url.searchParams.get('error') ?? '';
const errors: Record<string, string> = {
	form: 'The form could not be read. Please try again.',
	name: 'Please enter your name (at least 2 characters).',
	email: 'Please enter a valid email address — we reply to it.',
	topic: 'Please choose what your message is about.',
	message: 'Please write a message of at least 10 characters.',
	server: 'The message could not be saved right now. Please try again in a little while.',
};
const error = errors[errorCode] ?? '';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Contact — ${SITE_TITLE}`}
			description="Contact YTCPM support: sales questions, payment help, license activation and technical support. Support 6 days a week, 10 AM – 6 PM (New York)."
		/>
		<style>
			main {
				padding: 0;
			}
			.band {
				background: var(--surface);
				border-bottom: 1px solid rgb(var(--gray-light));
				padding: 2.8em 0 2.4em;
			}
			.band h1 {
				font-size: clamp(2em, 4.6vw, 2.9em);
			}
			.band p {
				max-width: 58ch;
				color: rgb(var(--gray-dark));
			}
			.body {
				padding: 2.6em 0 0.5em;
			}
			.layout {
				display: grid;
				grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
				gap: 1.4em;
				align-items: start;
			}
			@media (max-width: 820px) {
				.layout {
					grid-template-columns: 1fr;
				}
			}
			.card {
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.5em 1.6em;
			}
			.card h2 {
				font-size: 1.3em;
				margin-bottom: 0.4em;
			}
			.card h3 {
				font-size: 1.08em;
				margin-bottom: 0.35em;
			}
			.card p {
				font-size: 0.95em;
				line-height: 1.6;
				color: rgb(var(--gray-dark));
			}
			.side {
				display: grid;
				gap: 1.4em;
			}
			.notice {
				border-radius: 12px;
				padding: 1em 1.25em;
				margin-bottom: 1.2em;
				font-weight: 600;
			}
			.notice.ok {
				background: #dcfce7;
				color: #166534;
				border: 1px solid #86efac;
			}
			.notice.err {
				background: #fee2e2;
				color: #991b1b;
				border: 1px solid #fca5a5;
			}
			form.contact {
				display: grid;
				gap: 1em;
			}
			.field label {
				display: block;
				font-weight: 600;
				font-size: 0.92em;
				margin-bottom: 0.35em;
				color: rgb(var(--black));
			}
			.field input,
			.field select,
			.field textarea {
				width: 100%;
				font: inherit;
				font-size: 0.97em;
				padding: 0.6em 0.75em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 9px;
				background: var(--bg);
				color: rgb(var(--black));
				box-sizing: border-box;
			}
			.field input:focus,
			.field select:focus,
			.field textarea:focus {
				outline: 2px solid var(--accent);
				outline-offset: 1px;
				border-color: var(--accent);
			}
			.field textarea {
				min-height: 150px;
				resize: vertical;
			}
			.hp {
				position: absolute;
				left: -9999px;
				width: 1px;
				height: 1px;
				overflow: hidden;
			}
			button.send {
				font: inherit;
				font-weight: 700;
				background: var(--accent);
				color: #fff;
				border: none;
				border-radius: 999px;
				padding: 0.75em 1.7em;
				cursor: pointer;
				justify-self: start;
				box-shadow: 0 8px 22px rgba(234, 88, 12, 0.3);
			}
			button.send:hover {
				background: var(--accent-dark);
			}
			.fine {
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="band bleed">
				<div class="wrap">
					<h1>Talk to us</h1>
					<p>
						The <a href="/faq">FAQ</a> answers most questions in seconds. For
						everything else, send a message below — it goes straight to the team.
					</p>
				</div>
			</section>
			<section class="body bleed">
				<div class="wrap">
					{
						sent && (
							<p class="notice ok">
								Message sent — thank you. We reply to the email you gave us, usually
								within support hours (6 days a week, 10:00 AM – 6:00 PM New York time).
							</p>
						)
					}
					{error && <p class="notice err">{error}</p>}
					<div class="layout">
						<div class="card">
							<h2>Send a message</h2>
							<form class="contact" method="post" action="/api/contact">
								<div class="field">
									<label for="f-name">Your name</label>
									<input id="f-name" name="name" type="text" required maxlength="80" autocomplete="name" />
								</div>
								<div class="field">
									<label for="f-email">Email address</label>
									<input id="f-email" name="email" type="email" required maxlength="160" autocomplete="email" />
								</div>
								<div class="field">
									<label for="f-topic">How can we help?</label>
									<select id="f-topic" name="topic" required>
										<option value="" disabled selected>Choose a topic…</option>
										{CONTACT_TOPICS.map((t) => <option value={t}>{t}</option>)}
									</select>
								</div>
								<div class="field">
									<label for="f-message">Message</label>
									<textarea id="f-message" name="message" required minlength="10" maxlength="4000"></textarea>
								</div>
								<div class="hp" aria-hidden="true">
									<label>
										Leave this empty
										<input type="text" name="website" tabindex="-1" autocomplete="off" />
									</label>
								</div>
								<button class="send" type="submit">Send message</button>
								<p class="fine">
									We only use your details to answer you — see the
									<a href="/privacy">privacy policy</a>.
								</p>
							</form>
						</div>
						<div class="side">
							<div class="card">
								<h3>Support hours</h3>
								<p>
									Support is available 6 days a week, from 10:00 AM to
									6:00 PM (New York time).
								</p>
							</div>
							<div class="card">
								<h3>Already paid?</h3>
								<p>
									Payments are checked and licenses activated after confirmation —
									the admin contacts you within 24 hours. If it has been longer,
									send a message with your order ID and the email you ordered with.
								</p>
							</div>
							<div class="card">
								<h3>Learn it first</h3>
								<p>
									Most setup questions are answered in the
									<a href="/instructions">step-by-step instructions</a> and the
									<a href="/faq">FAQ</a>.
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
