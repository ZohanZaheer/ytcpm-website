---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { baSessionUser, verificationEnforced } from '../lib/baSession';
import AccountTop from '../components/AccountTop.astro';
import AccountSide from '../components/AccountSide.astro';
import { getEnv, getDatabaseUrl } from '../lib/env';
import { listOrdersForUser, type PaymentOrder } from '../lib/db';
import { getEffectiveSettings, type LicensePackage } from '../lib/settings';
import { formatUsd } from '../lib/packages';

export const prerender = false;

const user = await baSessionUser(Astro);
const mustVerify = !!user && verificationEnforced(Astro) && !user.emailVerified;
const verifyState = Astro.url.searchParams.get('verify') ?? '';
const justVerified = Astro.url.searchParams.get('verified') === '1';
if (!user) return Astro.redirect('/login');

interface LicenseView {
	order: PaymentOrder;
	state: 'pending' | 'active' | 'expired' | 'rejected';
	stateLabel: string;
	ordered: string;
	activated: string | null;
	expires: string | null;
	daysLeft: number | null;
}

let licenses: LicenseView[] = [];
let dbError = '';
const dbUrl = getDatabaseUrl(Astro);
if (!dbUrl) {
	dbError = 'Your orders cannot be loaded right now (database not configured).';
} else {
	try {
		const settings = await getEffectiveSettings(dbUrl, (k) => getEnv(Astro, k));
		const orders = await listOrdersForUser(dbUrl, user.id, user.email);
		const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
		const now = Date.now();
		licenses = orders.map((order) => {
			const pkg = settings.packages.find((p) => p.slug === order.package_slug);
			const ordered = dateFmt.format(new Date(order.created_at));
			if (order.status === 'pending') {
				return { order, state: 'pending', stateLabel: 'Waiting for payment confirmation', ordered, activated: null, expires: null, daysLeft: null };
			}
			if (order.status === 'rejected') {
				return { order, state: 'rejected', stateLabel: 'Rejected', ordered, activated: null, expires: null, daysLeft: null };
			}
			// Confirmed: updated_at is when the admin confirmed the order.
			const start = new Date(order.updated_at);
			const days = pkg?.durationDays ?? null;
			if (days === null) {
				return { order, state: 'active', stateLabel: 'Active — Lifetime', ordered, activated: dateFmt.format(start), expires: 'Never (Lifetime)', daysLeft: null };
			}
			const expiry = new Date(start.getTime() + days * 24 * 3600 * 1000);
			const daysLeft = Math.ceil((expiry.getTime() - now) / (24 * 3600 * 1000));
			return {
				order,
				state: daysLeft >= 0 ? 'active' : 'expired',
				stateLabel: daysLeft >= 0 ? 'Active' : 'Expired',
				ordered,
				activated: dateFmt.format(start),
				expires: dateFmt.format(expiry),
				daysLeft: Math.max(daysLeft, 0),
			};
		});
	} catch {
		dbError = 'Your orders cannot be loaded right now. Please try again shortly.';
	}
}

const hasActive = licenses.some((l) => l.state === 'active');

// Right-hand column of the dashboard: the packages the admin has
// ticked "Popular" (highest price first, at most 3, at least 1 —
// with the top-priced plan as the fallback when none are ticked).
let popularPkgs: LicensePackage[] = [];
try {
	const dbUrl2 = getDatabaseUrl(Astro);
	if (dbUrl2) {
		const s2 = await getEffectiveSettings(dbUrl2, (k) => getEnv(Astro, k));
		const activePkgs = s2.packages.filter((p) => p.active);
		const popular = activePkgs
			.filter((p) => p.popular)
			.sort((a, b) => b.priceUsd - a.priceUsd)
			.slice(0, 3);
		popularPkgs = popular.length > 0
			? popular
			: [...activePkgs].sort((a, b) => b.priceUsd - a.priceUsd).slice(0, 1);
	}
} catch {
	popularPkgs = [];
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`My account — ${SITE_TITLE}`}
			description="Your YTCPM licenses: packages, purchase dates, expiry and order status."
		/>
		<style>
			main {
				padding: 0;
			}
			.btn {
				font: inherit;
				font-weight: 700;
				text-decoration: none;
				padding: 0.6em 1.3em;
				border-radius: 999px;
				font-size: 0.93em;
				border: 1px solid rgb(var(--gray-light));
				background: var(--bg);
				color: rgb(var(--black));
				cursor: pointer;
			}
			.btn:hover {
				border-color: var(--accent);
				color: var(--accent-dark);
			}
			.btn.primary {
				background: var(--accent);
				border-color: var(--accent);
				color: #fff;
			}
			.btn.primary:hover {
				background: var(--accent-dark);
				color: #fff;
			}
			.body {
				padding: 2.2em 0 0.5em;
			}
			.body h2 {
				font-size: 1.4em;
				margin-bottom: 0.9em;
			}
			.error {
				color: #b00020;
				font-weight: 600;
			}
			.lic {
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.2em 1.4em;
				margin-bottom: 1em;
				max-width: 860px;
			}
			.lic-top {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em 1em;
				align-items: baseline;
				justify-content: space-between;
			}
			.lic-top h3 {
				font-size: 1.12em;
				margin: 0;
			}
			.notice {
				border-radius: 10px;
				padding: 0.9em 1.1em;
				margin-bottom: 1.2em;
				font-weight: 600;
				font-size: 0.95em;
			}
			.notice.ok {
				background: #dcfce7;
				color: #166534;
				border: 1px solid #86efac;
			}
			.notice.warn {
				background: #fef3c7;
				color: #92400e;
				border: 1px solid #fcd34d;
				font-weight: 500;
			}
			.creds {
				margin-top: 1em;
				background: #fff7ed;
				border: 1px dashed var(--accent);
				border-radius: 10px;
				padding: 0.9em 1.1em;
			}
			.creds h3 {
				margin: 0 0 0.5em;
				font-size: 1em;
			}
			.creds dl {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
				gap: 0.5em 1.4em;
				margin: 0;
			}
			.creds dt {
				font-size: 0.78em;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: rgb(var(--gray));
			}
			.creds dd {
				margin: 0.1em 0 0;
				font-weight: 700;
			}
			.creds code {
				font-size: 1.02em;
			}
			.creds .row-actions {
				margin-top: 0.8em;
			}
			.preparing {
				margin-top: 1em;
				font-weight: 600;
				color: #92400e;
			}
			.chip {
				font-size: 0.78em;
				font-weight: 700;
				padding: 0.3em 0.8em;
				border-radius: 999px;
				letter-spacing: 0.02em;
			}
			.chip.active {
				background: #dcfce7;
				color: #15803d;
			}
			.chip.pending {
				background: #fef3c7;
				color: #92400e;
			}
			.chip.expired,
			.chip.rejected {
				background: #fee2e2;
				color: #991b1b;
			}
			.facts {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
				gap: 0.7em 1.4em;
				margin: 0.9em 0;
			}
			.facts dt {
				font-size: 0.78em;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: rgb(var(--gray));
				font-weight: 600;
			}
			.facts dd {
				margin: 0.15em 0 0;
				font-weight: 600;
				color: rgb(var(--black));
			}
			.lic .links {
				font-size: 0.92em;
			}
			.dash-grid {
				display: grid;
				grid-template-columns: 228px minmax(0, 1fr) 320px;
				gap: 1.8em;
				align-items: start;
			}
			@media (max-width: 1180px) {
				.dash-grid {
					grid-template-columns: 228px minmax(0, 1fr);
				}
				.dash-side {
					grid-column: 2;
				}
			}
			@media (max-width: 860px) {
				.dash-grid {
					grid-template-columns: 1fr;
				}
				.dash-side {
					grid-column: auto;
				}
			}
			.dash-side .side-title {
				margin: 0.2em 0 0.9em;
				font-size: 1.15em;
			}
			.pkg-card {
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.15em 1.25em;
				box-shadow: var(--box-shadow);
				margin-bottom: 1em;
			}
			.pkg-dur {
				margin: 0;
				font-weight: 800;
				font-size: 1.1em;
			}
			.pkg-dev {
				margin: 0.15em 0 0;
				color: rgb(var(--gray-dark));
				font-size: 0.93em;
			}
			.pkg-price-row {
				display: flex;
				align-items: center;
				gap: 0.7em;
				flex-wrap: wrap;
				margin-top: 0.45em;
			}
			.pkg-price {
				margin: 0;
				font-size: 1.55em;
				font-weight: 800;
				color: var(--accent-dark);
			}
			.pkg-save {
				display: inline-block;
				margin: 0;
				font-size: 0.8em;
				font-weight: 700;
				background: #dcfce7;
				color: #166534;
				border-radius: 999px;
				padding: 0.15em 0.8em;
			}
			.pkg-buy {
				display: inline-block;
				margin-top: 0.8em;
			}
			.side-note {
				font-size: 0.93em;
			}
			.empty {
				max-width: 860px;
				background: var(--peach-soft);
				border: 1px solid var(--peach);
				border-radius: 14px;
				padding: 1.4em 1.5em;
			}
			.empty p {
				margin: 0 0 0.9em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<AccountTop name={user.name} email={user.email} hasActive={hasActive} />
			<section class="body bleed">
				<div class="wrap">
					<h2>My licenses &amp; orders</h2>
					{justVerified && (
						<p class="notice ok">✅ Your email is verified — thank you! You can complete a purchase now.</p>
					)}
					{mustVerify && (
						<div class="notice warn">
							<p style="margin:0 0 0.6em">
								<strong>Please verify your email.</strong> We sent a verification link to{' '}
								<strong>{user.email}</strong> — a verified email is required before a purchase can
								be completed.
							</p>
							{verifyState === 'sent' && <p style="margin:0 0 0.6em">✅ A new link has been sent — check your inbox (and spam folder).</p>}
							{verifyState === 'error' && <p style="margin:0 0 0.6em">⚠️ The email could not be sent just now — please try again.</p>}
							<form method="post" action="/api/account/resend-verification">
								<input type="hidden" name="back" value="/account" />
								<button class="btn" type="submit">Resend verification email</button>
							</form>
						</div>
					)}
					<div class="dash-grid">
						<AccountSide active="licenses" hasActive={hasActive} />
						<div class="dash-main">
					{
						dbError ? (
							<p class="error">{dbError}</p>
						) : licenses.length === 0 ? (
							<div class="empty">
								<p>
									<strong>No licenses yet.</strong> When you buy a plan, it will appear
									here with its purchase date, expiry and order status. Orders placed
									as a guest with this email show up here too.
								</p>
								<a class="btn primary" href="/pricing">See license plans</a>
							</div>
						) : (
							licenses.map((l) => (
								<article class="lic">
									<div class="lic-top">
										<h3>{l.order.package_label}</h3>
										<span class={`chip ${l.state}`}>{l.stateLabel}</span>
									</div>
									<dl class="facts">
										<div>
											<dt>Ordered</dt>
											<dd>{l.ordered}</dd>
										</div>
										<div>
											<dt>Amount</dt>
											<dd>
												{formatUsd(l.order.amount_usd)} · {l.order.crypto}
											</dd>
										</div>
										{l.activated && (
											<div>
												<dt>Activated</dt>
												<dd>{l.activated}</dd>
											</div>
										)}
										{l.expires && (
											<div>
												<dt>Expires</dt>
												<dd>{l.expires}</dd>
											</div>
										)}
										{l.daysLeft !== null && l.state === 'active' && (
											<div>
												<dt>Time left</dt>
												<dd>{l.daysLeft} days</dd>
											</div>
										)}
									</dl>
									<p class="links">
										<a href={`/pay/status/${l.order.id}`}>Order details &amp; status</a>
										{l.state === 'pending' && (
											<> — we confirm payments by review; the admin contacts you within 24 hours of confirmation.</>
										)}
										{l.state === 'expired' && (
											<> — <a href="/pricing">renew with a new plan</a></>
										)}
										{l.state === 'active' && (
											<> — <a href={`/account/support?order=${l.order.id}`}>Contact about this license</a></>
										)}
									</p>
									{l.order.status === 'confirmed' && (
										l.order.fulfilled_at && l.order.bot_username ? (
											<div class="creds">
												<h3>🤖 Your bot login</h3>
												<dl>
													<div>
														<dt>Username</dt>
														<dd><code>{l.order.bot_username}</code></dd>
													</div>
													<div>
														<dt>Password</dt>
														<dd><code>{l.order.bot_password}</code></dd>
													</div>
													<div>
														<dt>License</dt>
														<dd>{l.order.package_label}</dd>
													</div>
													{l.daysLeft !== null && (
														<div>
															<dt>Days remaining</dt>
															<dd>{l.daysLeft} days</dd>
														</div>
													)}
												</dl>
												<p class="row-actions">
													<a class="btn" href={`/account/support?order=${l.order.id}`}>
														Contact about this license
													</a>
												</p>
											</div>
										) : (
											<p class="preparing">
												⏳ Your bot login is being prepared — the admin is assigning your
												username &amp; password and they will appear here.
											</p>
										)
									)}
								</article>
							))
						)
					}
						</div>
						<aside class="dash-side">
							<h3 class="side-title">⭐ Popular packages</h3>
							{popularPkgs.map((p) => (
								<article class="pkg-card">
									<p class="pkg-dur">{p.duration}</p>
									<p class="pkg-dev">{p.devices} devices</p>
									<div class="pkg-price-row">
										<p class="pkg-price">{formatUsd(p.priceUsd)}</p>
										{p.saveNote && <span class="pkg-save">{p.saveNote}</span>}
									</div>
									<a class="btn primary pkg-buy" href={'/pay/' + p.slug}>Buy this plan</a>
								</article>
							))}
							<p class="side-note"><a href="/pricing">See all plans →</a></p>
						</aside>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
