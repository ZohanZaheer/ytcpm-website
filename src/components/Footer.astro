---
const today = new Date();
---

<footer class="site-footer">
	<div class="wrap cols">
		<div class="col brand-col">
			<a class="brand" href="/">
				<span class="brand-mark" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="18" height="18"><path fill="#fff" d="M8 5.5v13l11-6.5z" /></svg>
				</span>
				<span class="brand-name">YTCPM <span class="brand-accent">Bot</span></span>
			</a>
			<p class="blurb">
				A standalone Windows app for YouTube CPM workflows — multi-browser
				automation with proxy, fingerprint and user-agent controls.
			</p>
		</div>
		<nav class="col" aria-label="Product">
			<h3>Product</h3>
			<a href="/pricing">Pricing</a>
			<a href="/download">Download</a>
			<a href="/instructions">Instructions</a>
			<a href="/about">About</a>
		</nav>
		<nav class="col" aria-label="Resources">
			<h3>Resources</h3>
			<a href="/blog">Blog</a>
			<a href="/instructions">Setup guide</a>
			<a href="/pricing">License plans</a>
			<a href="/admin">Admin sign-in</a>
		</nav>
		<div class="col">
			<h3>Support</h3>
			<p>Support is available 6 days a week.</p>
			<p>Night support: 7:00 PM – 7:00 AM.</p>
			<p>Licenses activate after payment confirmation — usually within 24 hours.</p>
		</div>
	</div>
	<div class="wrap bottom">
		<p>&copy; {today.getFullYear()} YTCPM. All rights reserved.</p>
		<p class="fine">
			YTCPM Bot is an independent tool and is not affiliated with or endorsed
			by YouTube or Google. Any CPM or earnings figures are estimates, not
			guarantees.
		</p>
	</div>
</footer>
<style>
	.site-footer {
		background: #2a1d12;
		color: #e9dccb;
		margin-top: 4em;
	}
	.cols {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
		gap: 2em;
		padding-top: 3em;
		padding-bottom: 2em;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		text-decoration: none;
		color: #fff;
	}
	.brand-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 9px;
		background: linear-gradient(135deg, #f97316, var(--accent-dark));
	}
	.brand-name {
		font-family: "Plus Jakarta Sans", "Inter", sans-serif;
		font-weight: 800;
		font-size: 1.22em;
	}
	.brand-accent {
		color: #fb923c;
	}
	.blurb {
		margin-top: 0.9em;
		font-size: 0.92em;
		line-height: 1.6;
		color: #cbb59f;
		max-width: 34ch;
	}
	.col h3 {
		color: #fff;
		font-size: 1em;
		margin-bottom: 0.8em;
	}
	.col a {
		display: block;
		color: #e9dccb;
		text-decoration: none;
		padding: 0.28em 0;
		font-size: 0.95em;
	}
	.col a:hover {
		color: #fb923c;
	}
	.col p {
		font-size: 0.92em;
		line-height: 1.6;
		margin: 0 0 0.5em;
		color: #cbb59f;
	}
	.bottom {
		border-top: 1px solid rgba(233, 220, 203, 0.16);
		padding-top: 1.4em;
		padding-bottom: 2em;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em 2em;
		justify-content: space-between;
		font-size: 0.88em;
		color: #a68d73;
	}
	.bottom p {
		margin: 0;
	}
	.fine {
		max-width: 62ch;
	}
	@media (max-width: 880px) {
		.cols {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 520px) {
		.cols {
			grid-template-columns: 1fr;
		}
	}
</style>
