---
import { formatUsd, type LicensePackage } from '../../lib/packages';

interface Props {
	packages: LicensePackage[];
}
const { packages } = Astro.props;
---

<section class="pricing bleed">
	<div class="wrap">
		<p class="eyebrow">Pricing</p>
		<h2>Simple license plans, by devices and duration</h2>
		<p class="lead">
			Every plan includes the full bot. Devices reset every 10 days during an
			active license, and activation follows payment confirmation.
		</p>
		<div class="grid">
			{
				packages.map((p) => (
					<article class={`card ${p.popular ? 'popular' : ''}`}>
						{p.popular && <span class="badge">Most popular</span>}
						<h3>{p.duration}</h3>
						<p class="devices">{p.devices} devices</p>
						<p class="price">
							{formatUsd(p.priceUsd)}
							{p.saveNote && <span class="save">{p.saveNote}</span>}
						</p>
						<a class="buy" href={`/pay/${p.slug}`}>
							Buy this plan
						</a>
					</article>
				))
			}
		</div>
		<p class="more">
			Need another size? <a href="/pricing">See all plans</a> — custom and
			enterprise packages are available on request.
		</p>
	</div>
</section>
<style>
	.pricing {
		background: var(--surface);
		border-top: 1px solid rgb(var(--gray-light));
		border-bottom: 1px solid rgb(var(--gray-light));
		padding: 3.6em 0 3.2em;
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.75em;
		font-weight: 700;
		color: var(--accent);
		margin-bottom: 0.5em;
	}
	h2 {
		font-size: clamp(1.7em, 3.6vw, 2.3em);
	}
	.lead {
		max-width: 62ch;
		color: rgb(var(--gray-dark));
		margin-bottom: 2em;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1em;
	}
	.card {
		position: relative;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
		padding: 1.4em 1.4em 1.3em;
		background: var(--bg);
	}
	.card.popular {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}
	.badge {
		position: absolute;
		top: -0.75em;
		left: 1.2em;
		background: var(--accent);
		color: #fff;
		font-size: 0.72em;
		font-weight: 700;
		padding: 0.25em 0.7em;
		border-radius: 999px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.card h3 {
		font-size: 1.15em;
		margin-bottom: 0.15em;
	}
	.devices {
		margin: 0 0 0.7em;
		color: rgb(var(--gray-dark));
		font-size: 0.94em;
	}
	.price {
		font-family: "Plus Jakarta Sans", sans-serif;
		font-size: 1.9em;
		font-weight: 800;
		color: rgb(var(--black));
		margin: 0 0 0.8em;
		display: flex;
		align-items: center;
		gap: 0.5em;
		flex-wrap: wrap;
	}
	.save {
		font-family: "Inter", sans-serif;
		font-size: 0.42em;
		font-weight: 700;
		background: #dcfce7;
		color: #15803d;
		padding: 0.35em 0.7em;
		border-radius: 999px;
	}
	.buy {
		display: inline-block;
		background: var(--accent);
		color: #fff;
		font-weight: 700;
		text-decoration: none;
		padding: 0.6em 1.3em;
		border-radius: 999px;
		font-size: 0.95em;
	}
	.buy:hover {
		background: var(--accent-dark);
		color: #fff;
	}
	.more {
		margin: 1.6em 0 0;
	}
</style>
