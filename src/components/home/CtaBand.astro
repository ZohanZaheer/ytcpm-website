---
interface Props {
	version: string;
}
const { version } = Astro.props;
---

<section class="cta bleed">
	<div class="wrap cta-inner">
		<h2>Ready to put your CPM work on autopilot?</h2>
		<p>
			Download YTCPM Bot {version} for Windows, or pick a license plan and be
			running today.
		</p>
		<div class="ctas">
			<a class="btn btn-light" href="/download">Download the bot</a>
			<a class="btn btn-outline" href="/pricing">See pricing</a>
		</div>
	</div>
</section>
<style>
	.cta {
		background: linear-gradient(120deg, #f97316, var(--accent-dark));
		color: #fff;
	}
	.cta-inner {
		text-align: center;
		padding-top: 3.2em;
		padding-bottom: 3.2em;
	}
	.cta h2 {
		color: #fff;
		font-size: clamp(1.8em, 4vw, 2.5em);
	}
	.cta p {
		color: #ffedd5;
		max-width: 52ch;
		margin: 0 auto 1.6em;
	}
	.ctas {
		display: flex;
		gap: 0.7em;
		justify-content: center;
		flex-wrap: wrap;
	}
	.btn {
		font-weight: 700;
		text-decoration: none;
		padding: 0.75em 1.5em;
		border-radius: 999px;
		font-size: 0.98em;
	}
	.btn-light {
		background: #fff;
		color: var(--accent-dark);
	}
	.btn-light:hover {
		background: var(--peach-soft);
		color: var(--accent-dark);
	}
	.btn-outline {
		border: 1.5px solid rgba(255, 255, 255, 0.75);
		color: #fff;
	}
	.btn-outline:hover {
		border-color: #fff;
		color: #fff;
		background: rgba(255, 255, 255, 0.12);
	}
</style>
