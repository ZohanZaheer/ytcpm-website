---
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<div class="wrap bar">
		<a class="brand" href="/">
			<span class="brand-mark" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="18" height="18"><path fill="#fff" d="M8 5.5v13l11-6.5z" /></svg>
			</span>
			<span class="brand-name">YTCPM <span class="brand-accent">Bot</span></span>
		</a>
		<button class="menu-btn" id="nav-toggle" aria-label="Open menu" aria-expanded="false">
			<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
				<path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z" />
			</svg>
		</button>
		<nav class="main-nav" id="main-nav">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/pricing">Pricing</HeaderLink>
			<HeaderLink href="/download">Download</HeaderLink>
			<HeaderLink href="/instructions">Instructions</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
			<HeaderLink href="/account">Account</HeaderLink>
			<a class="cta" href="/pricing">Get the Bot</a>
		</nav>
	</div>
</header>
<script>
	const btn = document.getElementById('nav-toggle');
	const nav = document.getElementById('main-nav');
	btn?.addEventListener('click', () => {
		const open = nav?.classList.toggle('open');
		btn.setAttribute('aria-expanded', open ? 'true' : 'false');
	});
</script>
<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 247, 237, 0.92);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		min-height: 68px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.8em;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.brand-mark {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 9px;
		background: linear-gradient(135deg, #f97316, var(--accent-dark));
		box-shadow: 0 4px 12px rgba(234, 88, 12, 0.35);
	}
	.brand-name {
		font-family: "Plus Jakarta Sans", "Inter", sans-serif;
		font-weight: 800;
		font-size: 1.22em;
		letter-spacing: -0.01em;
	}
	.brand-accent {
		color: var(--accent);
	}
	.main-nav {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.main-nav a {
		padding: 0.45em 0.8em;
		border-radius: 999px;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95em;
		border-bottom: none;
	}
	.main-nav a:hover {
		background: var(--peach-soft);
		color: rgb(var(--black));
	}
	header .main-nav a.active {
		font-weight: 700;
		text-decoration: none;
		background: var(--peach-soft);
		color: var(--accent-dark);
	}
	.main-nav a.cta {
		margin-left: 0.6em;
		background: var(--accent);
		color: #fff;
		font-weight: 700;
		padding: 0.55em 1.15em;
		box-shadow: 0 4px 14px rgba(234, 88, 12, 0.35);
	}
	.main-nav a.cta:hover {
		background: var(--accent-dark);
		color: #fff;
	}
	.menu-btn {
		display: none;
		background: none;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		padding: 0.3em 0.45em;
		cursor: pointer;
		color: rgb(var(--black));
		line-height: 0;
	}
	@media (max-width: 880px) {
		.menu-btn {
			display: inline-block;
		}
		.main-nav {
			display: none;
			position: absolute;
			top: 68px;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0.15em;
			background: var(--bg);
			border-bottom: 1px solid rgb(var(--gray-light));
			padding: 0.7em 1.25em 1em;
			box-shadow: 0 18px 30px rgba(42, 29, 18, 0.12);
		}
		.main-nav.open {
			display: flex;
		}
		.main-nav a {
			padding: 0.65em 0.8em;
		}
		.main-nav a.cta {
			margin: 0.5em 0 0;
			text-align: center;
		}
	}
</style>
