---
// Shared top bar for the signed-in customer's pages (dashboard,
// profile, support): who is signed in, section links, sign out.
interface Props {
	name: string;
	email: string;
	active: 'dashboard' | 'profile' | 'support';
}
const { name, email, active } = Astro.props;
---

<div class="acct-nav">
	<p class="who">
		Signed in as <strong>{name}</strong> <span class="email">({email})</span>
	</p>
	<div class="links">
		<a href="/account" class={active === 'dashboard' ? 'on' : ''}>My licenses</a>
		<a href="/account/profile" class={active === 'profile' ? 'on' : ''}>My profile</a>
		<a href="/account/support" class={active === 'support' ? 'on' : ''}>Support</a>
		<form method="post" action="/api/account/logout">
			<button type="submit">Sign out</button>
		</form>
	</div>
</div>

<style>
	.acct-nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1em;
		flex-wrap: wrap;
		margin-bottom: 1.6em;
	}
	.who {
		margin: 0;
		color: rgb(var(--gray-dark));
	}
	.who .email {
		color: rgb(var(--gray));
		font-size: 0.92em;
	}
	.links {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		flex-wrap: wrap;
	}
	.links a,
	.links button {
		font: inherit;
		font-size: 0.92em;
		font-weight: 600;
		text-decoration: none;
		color: var(--accent-dark);
		background: var(--surface);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		padding: 0.45em 1.1em;
		cursor: pointer;
	}
	.links a.on {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}
	.links form {
		display: inline;
	}
</style>
