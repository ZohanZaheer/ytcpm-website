# ── YTCPM website — environment configuration ────────────────────────
# Copy to `.env` for local development, or set the same names in your
# host's environment settings (Cloudflare / Vercel / Node server).
# Never commit real values. See PAYMENTS_SETUP.md for the full guide.
#
# This is an EXAMPLE file: every value stays empty (or a harmless
# default). Real addresses, passwords and keys belong only in your
# host's secret settings — never in this file, never in the repo.
#
# On Cloudflare, two rules matter (see PAYMENTS_SETUP.md §5):
#   1. Values belong in "Runtime variables and secrets", NOT the
#      build-time section — Workers Builds syncs wrangler.json and
#      wipes build-time dashboard variables.
#   2. Secrets (DATABASE_URL, *_SECRET, *_TOKEN, *_KEY, passwords)
#      must be added with type "Secret".

# ── Database (REQUIRED) ──────────────────────────────────────────────
# PostgreSQL connection string — orders, accounts, admin users,
# packages and site settings all live here.
DATABASE_URL=

# ── Admin dashboard (/admin) ─────────────────────────────────────────
# Sign in with ADMIN_EMAIL + ADMIN_PASSWORD. While the admin table is
# empty, the first /admin sign-in creates the admin account from these
# two values (bootstrap); afterwards they remain an offline recovery
# path only. All three are REQUIRED for the dashboard.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs the admin login sessions. Also accepted as a one-time sign-in
# bridge: opening /admin?key=<ADMIN_SECRET> signs you in. Use a long
# random value.
ADMIN_SECRET=

# ── Customer accounts (better-auth) ──────────────────────────────────
# Secret used to sign customer sessions. Optional: when unset it falls
# back to ADMIN_SECRET. Set a separate long random value if you prefer
# the two systems fully independent.
BETTER_AUTH_SECRET=

# Public origin of the site, used to build absolute links (e.g. the
# email verification link). Defaults to https://ytcpm.cyou when unset —
# set it when running the same code on a different domain.
BETTER_AUTH_URL=

# ── Email verification (optional but recommended) ────────────────────
# Registration emails a verification link. Sending needs a provider:
# create a key at resend.com and set both values (as secrets). While
# these are empty, purchases are not blocked on verification; once
# set, checkout requires a verified email automatically.
RESEND_API_KEY=
<redacted>
# ── Payments ─────────────────────────────────────────────────────────
# The addresses the /pay checkout pages show. Note: values saved in
# the admin dashboard (/admin/settings) override these. BTC/ETH may
# stay empty to hide that currency at checkout.
PAYMENT_USDT_ADDRESS=
# USDT network: TRC20 or ERC20
PAYMENT_USDT_NETWORK=TRC20
PAYMENT_BTC_ADDRESS=
PAYMENT_ETH_ADDRESS=

# Automatic on-chain confirmation (optional)
# BTC uses the public mempool.space API and USDT-TRC20 uses Trongrid —
# neither needs a key. ETH / USDT-ERC20 checks need a free Etherscan key:
ETHERSCAN_API_KEY=

# ── Payment screenshot storage ───────────────────────────────────────
# Screenshot storage driver: local | s3 | github
# - local: Node servers / VPS / local dev only (not persistent on
#   Cloudflare Workers or Vercel serverless)
# - s3: any S3-compatible storage incl. Cloudflare R2 (recommended
#   for high volume)
# - github: commits images into a repo (fine for low volume)
STORAGE_DRIVER=github

# local driver: folder for saved screenshots
UPLOAD_DIR=uploads/payment-screenshots

# S3 / R2 settings (STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=payment-screenshots
# Public base URL of the bucket, if screenshots should be linkable
S3_PUBLIC_BASE=

# GitHub storage settings (STORAGE_DRIVER=github)
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_UPLOAD_DIR=payment-screenshots
# Fine-grained personal access token with Contents read/write on the
# storage repo only.
GITHUB_TOKEN=

# Max screenshot upload size in bytes (default 5242880 = 5 MB)
MAX_UPLOAD_BYTES=5242880

# ── Build target (build-time shell variable, NOT an app setting) ────
# Which hosting adapter to build for — see astro.config.mjs:
#   DEPLOY_TARGET=cloudflare (default) | node | vercel
#   npm run build  /  npm run build:node  /  npm run build:vercel
