# ── YTCPM Bot payments configuration ─────────────────────────────────
# Copy to `.env` (local dev) or set the same names in your host's
# environment settings (Vercel / Cloudflare / cPanel). Never commit real
# values. See PAYMENTS_SETUP.md for full instructions.

# Payment addresses (REQUIRED for checkout — the /pay pages show these)
PAYMENT_USDT_ADDRESS=
# USDT network: TRC20 or ERC20
PAYMENT_USDT_NETWORK=TRC20
PAYMENT_BTC_ADDRESS=
PAYMENT_ETH_ADDRESS=

# PostgreSQL (REQUIRED for orders). On Cloudflare you can instead add a
# (A plain DATABASE_URL like this works on every platform.)
DATABASE_URL=postgres://user:password@host:5432/database

# — apni email or apna pasandeeda password
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Admin page (/admin?key=...) — choose a long random secret (REQUIRED)
ADMIN_SECRET=

# Screenshot storage driver: local | s3 | github
# - local: Node servers / cPanel / local dev only (not persistent on
#   Cloudflare Workers or Vercel serverless)
# - s3: any S3-compatible storage incl. Cloudflare R2 (recommended)
# - github: commits images into a repo (fine for low volume)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads/payment-screenshots

# S3 / R2 settings (STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=payment-screenshots
# Public base URL of the bucket, if screenshots should be linkable
S3_PUBLIC_BASE=

# GitHub storage settings (STORAGE_DRIVER=github)
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_UPLOAD_DIR=payment-screenshots
GITHUB_TOKEN=

# Automatic on-chain confirmation (optional)
# BTC uses the public mempool.space API and USDT-TRC20 uses Trongrid —
# neither needs a key. ETH / USDT-ERC20 checks need a free Etherscan key:
ETHERSCAN_API_KEY=

# Max screenshot upload size in bytes (default 5242880 = 5 MB)
MAX_UPLOAD_BYTES=5242880
